# --- GitHub 配置 ---
# 目标仓库，格式为 '用户名/仓库名'
GITHUB_REPO=yourname/blog
# GitHub 令牌 (本地建议配置以避免 API 频率限制，CI 环境会自动获取)
GITHUB_TOKEN=

# --- 在线服务：GitHub 登录、评论与 AI 问答 ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
BLOG_AUTHOR_GITHUB_ID=
FRONTEND_URL=http://localhost:4321
ALLOWED_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321","https://blog.xiaowo.live"]
SESSION_COOKIE_SECURE=false
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://blog:change-me@localhost:5432/blog
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=sk-xxxx
LLM_API_MODEL=deepseek-v4-flash
BLOG_POSTS_BASE_URL=https://static.example.com/_posts/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- LLM 配置 (用于生成文章摘要、SEO 和专栏) ---
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# --- 多吉云 (DogeCloud) 基础配置 ---
# 访问密钥，可在多吉云控制台 - 密钥管理获取
DOGECLOUD_ACCESS_KEY=your_access_key
DOGECLOUD_SECRET_KEY=your_secret_key

# --- 图床配置 (用于处理文章中的图片上传) ---
# 存储空间名称 (简单名，如 my-blog-img)
DOGECLOUD_BUCKET=your_image_bucket_name
# 图床自定义加速域名 (必须包含 https:// 前缀)
DOGECLOUD_DOMAIN=https://img.example.com

# --- 静态网站部署配置 (用于上传 apps/blog/dist) ---
# 静态网站存储空间名称 (如 my-blog-static)
DOGECLOUD_STATIC_BUCKET=your_static_bucket_name
# 静态网站自定义域名 (包含 https:// 前缀，用于生成 Sitemap 和前端 site 属性)
DOGECLOUD_STATIC_DOMAIN=https://blog.example.com

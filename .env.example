# blog-core：文章数据生成、图片处理与静态站部署

# GitHub 数据源
GITHUB_REPO=yourname/blog
GITHUB_TOKEN=

# 文章构建 LLM
BLOG_CORE_LLM_API_KEY=sk-xxxx
BLOG_CORE_LLM_API_BASE=https://api.deepseek.com
BLOG_CORE_LLM_API_MODEL=deepseek-v4-flash
LLM_CACHE_ENABLED=true
MAX_ARTICLE_CONCURRENCY=5
MAX_LLM_CONCURRENCY=100

# 多吉云凭据
DOGECLOUD_ACCESS_KEY=your_access_key
DOGECLOUD_SECRET_KEY=your_secret_key

# 图床
DOGECLOUD_IMAGE_BUCKET=your_image_bucket_name
DOGECLOUD_IMAGE_DOMAIN=https://img.example.com

# 静态网站
DOGECLOUD_STATIC_BUCKET=your_static_bucket_name
DOGECLOUD_STATIC_DOMAIN=https://blog.example.com

# 上传并发
MAX_IMAGE_CONCURRENCY=10
STATIC_UPLOAD_WORKERS=10

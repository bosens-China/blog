---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import MoreLink from '@/components/common/MoreLink.astro';
import { routes } from '@/utils/routes';
---

<Layout title="页面不存在">
  <PageHeader title="404" subtitle="你访问的页面不存在，可能已被移动或删除。" />
  <MoreLink href={routes.home()} text="返回首页" />
</Layout>

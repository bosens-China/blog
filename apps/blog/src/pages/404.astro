---
import '@unocss/reset/tailwind.css';
import '@/styles/vars.css';
import '@/styles/base.css';
import 'uno.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Not Found</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'auto';
      const isDark =
        theme === 'dark' ||
        (theme === 'auto' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);
    </script>
    <style>
      .blink {
        animation: blink 1s step-end infinite;
      }
      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }
      .typewriter h1 {
        overflow: hidden;
        white-space: nowrap;
        animation: typing 2s steps(40, end);
      }
      @keyframes typing {
        from {
          width: 0;
        }
        to {
          width: 100%;
        }
      }
    </style>
  </head>
  <body
    class="bg-base-bg text-base-text transition-colors duration-200 flex items-center justify-center min-h-screen font-mono p-4"
  >
    <div
      class="w-full max-w-2xl bg-base-bg border border-base-border rounded-lg shadow-2xl overflow-hidden transform hover:-translate-y-1 transition-transform duration-300"
    >
      <!-- 终端头部 -->
      <div
        class="bg-base-border/30 px-4 py-2 flex items-center gap-2 border-b border-base-border/50"
      >
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
        <div class="ml-4 text-xs text-base-text-light opacity-60">
          xiaowo@server: ~
        </div>
      </div>

      <!-- 终端内容 -->
      <div class="p-6 md:p-8 space-y-4 text-sm md:text-base">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 text-primary">
            <span>➜</span>
            <span class="font-bold">~</span>
            <span class="text-base-text"
              >access --url <span class="italic opacity-70">current_page</span
              ></span
            >
          </div>
          <div class="text-red-500 font-bold">Error: 404 Not Found</div>
          <div class="text-base-text-light opacity-80 pl-4">
            您访问的资源不存在，可能已被移除、重命名或暂时不可用。
          </div>
        </div>

        <div class="h-4"></div>

        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 text-primary">
            <span>➜</span>
            <span class="font-bold">~</span>
            <span class="text-base-text">what_next?</span>
          </div>
          <div class="pl-4 pt-2 flex items-center flex-wrap gap-x-2">
            <span class="text-base-text-light mr-2">> </span>
            <a
              href="/"
              class="inline-block px-1 bg-primary text-white font-bold hover:opacity-90"
            >
              cd /home
            </a>
            <span
              class="text-base-text-light opacity-50 text-xs md:text-sm italic"
              ># 返回首页</span
            >
            <span class="blink inline-block w-2.5 h-5 bg-base-text align-middle"
            ></span>
          </div>
        </div>
      </div>
    </div>

    <footer
      class="fixed bottom-8 text-xs font-mono text-base-text-light opacity-30 tracking-widest uppercase"
    >
      Xiaowo's Blog
    </footer>
  </body>
</html>

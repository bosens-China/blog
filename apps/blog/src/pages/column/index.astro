---
import Layout from '@/layouts/Layout.astro';
import { siteMeta, allPosts } from '@/utils/data';

const columns = (siteMeta.columns || []).map(column => {
	// 获取该专栏下的前 3 篇文章
	const posts = column.article_ids
		.map(id => allPosts.find(p => p.id === id))
		.filter(Boolean)
		.slice(0, 3);
	
	return {
		...column,
		posts
	};
});
---

<Layout title="专栏列表">
	<div class="py-4">
		<header class="mb-10 pb-8 border-b border-base-border">
			<h1 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight text-base-text">专栏</h1>
			<p class="text-base-text-light">系列文章合集</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{columns.map(column => (
				<div class="group p-6 rounded-2xl border border-base-border bg-base-bg hover:border-primary/30 transition-all duration-300 flex flex-col gap-4">
					<a href={`/column/${column.id}`} class="flex flex-col gap-2 group/title">
						<div class="flex items-center justify-between">
							<h2 class="text-lg font-bold group-hover/title:text-primary transition-colors line-clamp-1 text-base-text">
								{column.name}
							</h2>
							<span class="text-xs font-mono text-base-text-light bg-base-border/30 px-2 py-1 rounded">
								{column.article_ids.length} Posts
							</span>
						</div>
						<p class="text-sm text-base-text-light line-clamp-2 leading-relaxed">
							{column.description}
						</p>
					</a>

					<div class="h-px bg-base-border/50"></div>

					<div class="flex flex-col gap-2">
						{column.posts.map(post => (
							<a 
								href={`/posts/${post!.id}`} 
								class="text-sm text-base-text-light hover:text-primary transition-colors line-clamp-1 flex items-center gap-2"
							>
								<div class="w-1 h-1 rounded-full bg-base-border"></div>
								{post!.title}
							</a>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>

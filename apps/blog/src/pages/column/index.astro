---
import Layout from '../../layouts/Layout.astro';
import { siteMeta } from '../../utils/data';

const columns = siteMeta.columns || [];
---

<Layout title="专栏列表">
	<div class="py-4">
		<header class="mb-10 pb-8 border-b border-gray-100 dark:border-gray-800">
			<h1 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight">专栏</h1>
			<p class="text-gray-500 dark:text-gray-400">系列文章合集</p>
		</header>

		<div class="flex flex-col">
			{columns.map(column => (
				<div class="group py-8 border-b border-gray-100 dark:border-gray-800 last:border-none">
					<a href={`/column/${column.id}`} class="block group">
						<h2 class="text-xl font-bold group-hover:text-primary transition-colors mb-3">
							{column.name}
						</h2>
						<p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">
							{column.description}
						</p>
						<div class="text-xs font-medium text-gray-400">
							{column.article_ids.length} 篇文章
						</div>
					</a>
				</div>
			))}
		</div>
	</div>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import BackButton from '@/components/common/BackButton.astro';
import { siteMeta, allPosts } from '@/utils/data';

export async function getStaticPaths() {
  return (siteMeta.columns || []).map((column) => ({
    params: { slug: column.id },
    props: { column },
  }));
}

const { column } = Astro.props;
const columnPosts = column.article_ids
  .map((id) => allPosts.find((p) => p.id === id))
  .filter(Boolean) as any[];
---

<Layout title={column.name}>
  <div class="py-4">
    <header class="mb-8 pb-8 border-b border-base-border">
      <div class="mb-6">
        <BackButton href="/column" text="返回专栏列表" />
      </div>

      <h1
        class="text-2xl md:text-3xl font-bold mb-4 tracking-tight text-base-text"
      >
        {column.name}
      </h1>

      <p class="text-base-text-light leading-relaxed text-base">
        {column.description}
      </p>
    </header>

    <div class="flex flex-col">
      {columnPosts.map((post) => <PostCard post={post} hideSeries={true} />)}
    </div>
  </div>
</Layout>

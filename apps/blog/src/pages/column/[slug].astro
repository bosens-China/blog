---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { siteMeta, allPosts } from '../../utils/data';

export async function getStaticPaths() {
	return (siteMeta.columns || []).map(column => ({
		params: { slug: column.id },
		props: { column },
	}));
}

const { column } = Astro.props;
const columnPosts = column.article_ids
	.map(id => allPosts.find(p => p.id === id))
	.filter(Boolean) as any[];
---

<Layout title={column.name}>
	<div class="py-4">
		<header class="mb-8 pb-8 border-b border-gray-100 dark:border-gray-800">
			<a href="/column" class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-primary mb-6 transition-colors font-mono">
				<div class="i-carbon-arrow-left"></div> 返回专栏列表
			</a>
			
			<h1 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight">{column.name}</h1>
			
			<p class="text-gray-500 dark:text-gray-400 leading-relaxed text-base">
				{column.description}
			</p>
		</header>

		<div class="flex flex-col">
			{columnPosts.map((post) => (
				<PostCard post={post} hideSeries={true} />
			))}
		</div>
	</div>
</Layout>

---
import type { Page } from 'astro';
import type { Post } from '@/utils/data';
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import { sortedPosts } from '@/utils/data';
import Pagination from '@/components/common/Pagination.astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const PAGE_SIZE = 10;
  return paginate(sortedPosts, { pageSize: PAGE_SIZE });
}

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const title = page.currentPage === 1 ? '最新文章' : `第 ${page.currentPage} 页`;
---

<Layout title={title}>
  <div>
    {page.data.map((post: Post) => <PostCard post={post} />)}
  </div>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</Layout>

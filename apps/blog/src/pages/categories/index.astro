---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import { categories } from '@/utils/categories';
import { routes } from '@/utils/routes';
---

<Layout title="分类">
  <PageHeader title="分类" subtitle={`共 ${categories.length} 个分类`} />
  <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-4">
    {
      categories.map((category) => (
        <li>
          <a
            href={routes.category(category.name)}
            class="group inline-flex items-baseline gap-1.5"
          >
            <span class="text-[15px] sm:text-base text-base-text group-hover:text-primary-text transition-colors">
              {category.name}
            </span>
            <span class="text-xs text-base-text-light tabular-nums">
              {category.posts.length}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

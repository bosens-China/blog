---
import Layout from '@/layouts/Layout.astro';
import { allPosts, siteMeta } from '@/utils/data';
import PostTags from '@/components/PostTags.astro';
import MarkdownRenderer from '@/components/MarkdownRenderer.astro';
import { formatDate } from '@/utils/date';
import AskAIWidget from '@/components/AskAIWidget';
import ViewCounter from '@/components/ViewCounter.astro';

export async function getStaticPaths() {
  return allPosts.map((post) => ({
    params: { id: post.id.toString() },
    props: { post },
  }));
}

const { post } = Astro.props;
const postMeta = siteMeta.posts_meta[post.id.toString()];

const date = formatDate(post.updated_at || post.created_at);
// 优先使用文章第一张图作为分享图，否则使用默认 favicon
const shareImage = post.images?.[0] || undefined;
---

<Layout
  title={post.title}
  description={postMeta?.seo?.description ?? ''}
  keywords={postMeta?.seo?.keywords ?? []}
  image={shareImage}
>
  <article class="py-8" data-pagefind-body>
    <!-- 头部区域 -->
    <header class="mb-10 pb-8 border-b border-base-border">
      <h1
        class="text-2xl md:text-3xl font-bold mb-6 leading-tight tracking-tight text-base-text"
      >
        {post.title}
      </h1>

      <div
        class="flex flex-wrap items-center justify-between gap-4 text-sm font-medium text-base-text-light"
      >
        <PostTags post={post} />
        <div class="flex items-center gap-4 opacity-60 font-mono text-xs">
          <span class="flex items-center gap-1.5">
            <div class="i-carbon-character-patterns w-3.5 h-3.5"></div>
            {post.word_count} 字
          </span>
          <span class="flex items-center gap-1.5">
            <div class="i-carbon-timer w-3.5 h-3.5"></div>
            {post.reading_time} 分钟
          </span>
          <time datetime={post.updated_at} class="flex items-center gap-1.5">
            <div class="i-carbon-calendar w-3.5 h-3.5"></div>
            {date}
          </time>
          <ViewCounter path={`/posts/${post.id}`} />
        </div>
      </div>
    </header>

    <!-- 正文区域：MarkdownRenderer 内部已包含 prose 容器 -->
    <MarkdownRenderer content={post.body} />

    <!-- 文章页脚：版权声明 -->
    <footer class="mt-16 pt-8" hidden={!post.body.trim().length}>
      <div
        class="bg-base-fill-subtle/30 rounded-xl p-6 border border-base-border/50 transition-colors"
      >
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
          <div class="space-y-1">
            <h4
              class="text-sm font-bold text-base-text flex items-center gap-2"
            >
              <div class="i-carbon-license w-4 h-4 text-primary"></div>
              版权声明
            </h4>
            <p class="text-xs text-base-text-light leading-relaxed">
              本文采用 <a
                href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                target="_blank"
                class="text-primary hover:underline font-medium"
                >CC BY-NC-SA 4.0</a
              > 协议进行许可。转载请保留原文链接及作者。
            </p>
          </div>
          <div
            class="flex items-center gap-2 opacity-60 grayscale hover:grayscale-0 transition-all"
          >
            <div class="i-simple-icons-creativecommons w-6 h-6"></div>
            <div class="i-simple-icons-creativecommonsshare w-6 h-6"></div>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <AskAIWidget client:idle postId={post.id} title={post.title} />
</Layout>

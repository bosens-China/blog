---
import Layout from '@/layouts/Layout.astro';
import { formatDate } from '@/utils/date';
import { weekly, weeklyIssues } from '@/utils/weekly';

const lastBuildDate = weekly.last_build_date
  ? formatDate(weekly.last_build_date)
  : '';
---

<Layout
  title="GitHub 一周热点"
  description="每周同步 GitHub Trending 热点项目，整理值得关注的开源社区新动态。"
  keywords={['GitHub', '一周热点', '开源', 'Trending']}
>
  <section class="py-4">
    <header class="mb-10 pb-8 border-b border-base-border">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <p class="mb-3 text-sm font-mono text-primary-text">Weekly Trend</p>
          <h1
            class="text-2xl md:text-3xl font-bold mb-4 tracking-tight text-base-text"
          >
            GitHub 一周热点
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-muted">
            每周一 9 点更新，梳理过去一周 GitHub
            上值得关注的热门项目与开源动态。
          </p>
        </div>
        {
          lastBuildDate && (
            <div class="text-xs font-mono text-muted">
              最后同步于 {lastBuildDate}
            </div>
          )
        }
      </div>
    </header>

    {
      weeklyIssues.length > 0 ? (
        <div class="grid grid-cols-1 gap-5">
          {weeklyIssues.map((issue, index) => (
            <article class="group relative overflow-hidden rounded-2xl border border-base-border bg-base-bg p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg">
              <a
                href={`/weekly/${issue.slug}/`}
                class="absolute inset-0 z-0"
                aria-label={`阅读 ${issue.title}`}
              />

              <div class="relative z-10 flex flex-col gap-5 md:flex-row md:items-center md:justify-between pointer-events-none">
                <div class="min-w-0">
                  <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-mono text-muted">
                    <span class="rounded-full bg-primary-subtle px-3 py-1 text-primary-text">
                      #{String(weeklyIssues.length - index).padStart(2, '0')}
                    </span>
                    {issue.pub_date && (
                      <time datetime={issue.pub_date}>
                        {formatDate(issue.pub_date)}
                      </time>
                    )}
                  </div>
                  <h2 class="text-xl font-bold tracking-tight text-base-text transition-colors group-hover:text-primary-text">
                    {issue.title}
                  </h2>
                  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">
                    {issue.description || issue.source_title}
                  </p>
                </div>

                <div class="flex shrink-0 items-center gap-4 text-xs font-mono text-muted">
                  <span class="flex items-center gap-1.5">
                    <div class="i-carbon-character-patterns h-3.5 w-3.5" />
                    {issue.word_count} 字
                  </span>
                  <span class="flex items-center gap-1.5">
                    <div class="i-carbon-timer h-3.5 w-3.5" />
                    {issue.reading_time} 分钟
                  </span>
                  <span class="flex items-center gap-1 text-primary-text opacity-0 -translate-x-2 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                    阅读 <div class="i-carbon-arrow-right" />
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-base-border bg-base-fill p-10 text-center">
          <div class="mx-auto mb-4 h-12 w-12 rounded-full bg-primary-subtle flex items-center justify-center text-primary-text">
            <div class="i-carbon-rss h-6 w-6" />
          </div>
          <h2 class="text-lg font-bold text-base-text">暂无周刊数据</h2>
          <p class="mt-2 text-sm text-muted">
            首次同步完成后，这里会自动展示最新周刊。
          </p>
        </div>
      )
    }
  </section>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import MoreLink from '@/components/common/MoreLink.astro';
import RowList from '@/components/list/RowList.astro';
import SummaryRow from '@/components/list/SummaryRow.astro';
import { formatDate } from '@/utils/date';
import { routes } from '@/utils/routes';
import {
  getWeeklyIssueNumber,
  getWeeklySummary,
  weeklyIssues,
} from '@/utils/weekly';
---

<Layout
  title="周刊"
  description="每周一更新，收录本周值得关注的 GitHub 开源项目。"
  keywords={['GitHub', '周刊', '开源', 'Trending']}
>
  <PageHeader title="周刊" subtitle="每周一更新，收录本周值得关注的开源项目" />
  {
    weeklyIssues.length > 0 ? (
      <RowList>
        {weeklyIssues.map((issue) => {
          const number = getWeeklyIssueNumber(issue);
          return (
            <SummaryRow
              href={routes.weekly(issue.slug)}
              title={number ? `第 ${number} 期` : issue.title}
              description={getWeeklySummary(issue)}
              meta={[{ text: formatDate(issue.pub_date) }]}
            />
          );
        })}
      </RowList>
    ) : (
      <p class="text-sm text-base-text-light">暂无周刊</p>
    )
  }
  <MoreLink href={routes.weeklyRss()} text="订阅周刊 RSS" />
</Layout>

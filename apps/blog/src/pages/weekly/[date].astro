---
import Layout from '@/layouts/Layout.astro';
import BackToTop from '@/components/common/BackToTop.astro';
import MarkdownRenderer from '@/components/MarkdownRenderer.astro';
import { formatDateTime } from '@/utils/date';
import { getWeeklyProjectCount, weeklyIssues } from '@/utils/weekly';

export async function getStaticPaths() {
  return weeklyIssues.map((issue) => ({
    params: { date: issue.slug },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const shareImage = issue.images?.[0] || undefined;
const hasStructuredReport = (issue.categories?.length ?? 0) > 0;
const publishedDate = formatDateTime(issue.date || issue.pub_date);
const projectCount = getWeeklyProjectCount(issue);
const detailMetaHtml = hasStructuredReport
  ? `<div class="not-prose mt-4 mb-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted"><span class="inline-flex items-center gap-1.5"><span class="i-carbon-calendar w-3.5 h-3.5"></span>发布于 ${publishedDate}</span><span class="text-base-border">·</span><span class="inline-flex items-center gap-1.5"><span class="i-carbon-cube w-3.5 h-3.5"></span>本期收录 ${projectCount} 个项目</span><span class="text-base-border">·</span><span class="inline-flex items-center gap-1.5 view-counter" data-path="/weekly/${issue.slug}" title="阅读量"><span class="i-carbon-view w-3.5 h-3.5"></span><span class="view-count-value">0</span><span>次阅读</span></span></div>`
  : '';
---

<Layout
  title={issue.title}
  description={issue.description || issue.source_title}
  keywords={['GitHub', '一周热点', '开源', 'Trending']}
  image={shareImage}
>
  <article class="py-8" data-pagefind-body>
    <div class="weekly-markdown">
      <MarkdownRenderer
        content={issue.body}
        afterFirstHeadingHtml={detailMetaHtml}
      />
    </div>
  </article>

  <BackToTop />
</Layout>

<style is:global>
  .weekly-markdown .prose figure,
  .weekly-markdown .prose picture {
    text-align: center;
  }

  .weekly-markdown .prose img {
    width: auto !important;
    max-width: 100%;
    margin-inline: auto;
  }
</style>

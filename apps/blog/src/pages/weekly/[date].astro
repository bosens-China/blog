---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { formatDate } from '@/utils/date';
import { getAdjacent } from '@/utils/adjacent';
import { routes } from '@/utils/routes';
import {
  getWeeklyBody,
  getWeeklyProjectCount,
  weeklyIssues,
  type WeeklyIssue,
} from '@/utils/weekly';
import type { MetaItem } from '@/types/article';

export function getStaticPaths() {
  return weeklyIssues.map((issue) => ({
    params: { date: issue.slug },
    props: { issue },
  }));
}

interface Props {
  issue: WeeklyIssue;
}

const { issue } = Astro.props;
const projectCount = getWeeklyProjectCount(issue);

// 按期数正序（旧 → 新）
const readingOrder = [...weeklyIssues].reverse();
const adjacent = getAdjacent(
  readingOrder,
  (item) => item.slug === issue.slug,
  (item) => ({ title: item.title, href: routes.weekly(item.slug) }),
);

const meta: MetaItem[] = [
  { text: formatDate(issue.pub_date) },
  { text: '周刊', href: routes.weeklyList() },
  { text: projectCount ? `收录 ${projectCount} 个项目` : '' },
  { text: issue.reading_time ? `${issue.reading_time} 分钟` : '' },
];
---

<ArticleLayout
  title={issue.title}
  description={issue.description || issue.source_title}
  keywords={['GitHub', '周刊', '开源', 'Trending']}
  image={issue.images?.[0]}
  kind="周刊"
  meta={meta}
  content={getWeeklyBody(issue)}
  adjacent={adjacent}
  contentClass="weekly-markdown"
/>

<style is:global>
  .weekly-markdown .prose figure,
  .weekly-markdown .prose picture {
    text-align: center;
  }

  .weekly-markdown .prose img {
    width: auto !important;
    max-width: 100%;
    margin-inline: auto;
  }
</style>

---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import BackButton from '@/components/common/BackButton.astro';
import { allLabels, sortedPosts } from '@/utils/data';

export async function getStaticPaths() {
  return allLabels.map((label) => ({
    params: { slug: label.name },
    props: { label },
  }));
}

interface Label {
  name: string;
  color: string;
}

const { label } = Astro.props as { label: Label };

const postsWithLabel = sortedPosts.filter((post) =>
  post.labels.some((l) => l.name === label.name),
);
---

<Layout title={`分类: ${label.name}`}>
  <div class="max-w-4xl mx-auto py-8">
    <BackButton href="/category/" text="返回分类列表" />

    <header class="mb-8 mt-8 pb-8 border-b border-base-border">
      <div class="flex items-center gap-4">
        <span
          class="w-4 h-4 rounded-full"
          style={`background-color: #${label.color}`}></span>
        <h1
          class="text-2xl md:text-3xl font-bold tracking-tight text-base-text"
        >
          {label.name}
        </h1>
      </div>
      <p class="text-sm mt-4 text-base-text-light">
        共 {postsWithLabel.length} 篇文章
      </p>
    </header>

    <div class="space-y-4">
      {
        postsWithLabel.map((post, index) => (
          <PostCard post={post} index={index} />
        ))
      }
    </div>
  </div>
</Layout>

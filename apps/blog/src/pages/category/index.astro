---
import Layout from '@/layouts/Layout.astro';
import { allLabels, allPosts } from '@/utils/data';
import { createCategorySlug } from '@/utils/slug';

const labels = allLabels.map((label) => {
  // 获取该分类下的前 3 篇文章
  const posts = allPosts
    .filter((post) => post.labels.some((l) => l.name === label.name))
    .sort(
      (a, b) =>
        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
    )
    .slice(0, 3);

  // 计算该分类文章总数
  const total = allPosts.filter((post) =>
    post.labels.some((l) => l.name === label.name),
  ).length;

  return {
    ...label,
    slug: createCategorySlug(label.name),
    posts,
    total,
  };
});
---

<Layout title="文章分类">
  <div class="mx-auto py-4">
    <header class="mb-10 pb-8 border-b border-base-border">
      <h1
        class="text-2xl md:text-3xl font-bold mb-4 tracking-tight text-base-text"
      >
        分类
      </h1>
      <p class="text-base-text-light">文章标签索引</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        labels.map((label) => (
          <div class="group relative p-6 rounded-2xl border border-base-border bg-base-bg hover:border-primary/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col gap-4">
            {/* 卡片整体链接 (背景) */}
            <a
              href={`/category/${label.slug}/`}
              class="absolute inset-0 z-0"
              aria-label={`View category ${label.name}`}
            />

            <div class="flex items-center justify-between pointer-events-none">
              <div class="flex items-center gap-3">
                <span
                  class="w-3 h-3 rounded-full"
                  style={`background-color: #${label.color}`}
                />
                <h2 class="text-lg font-bold group-hover:text-primary-text transition-colors text-base-text">
                  {label.name}
                </h2>
              </div>
              <span class="text-xs font-mono text-muted bg-base-border/30 px-2 py-1 rounded">
                {label.total} 篇文章
              </span>
            </div>

            <div class="h-px bg-base-border/50" />

            <div class="flex flex-col gap-2 relative z-10">
              <span class="text-xs font-bold text-muted uppercase tracking-wider mb-1 opacity-80 pointer-events-none">
                最新更新
              </span>
              {label.posts.map((post, idx) => (
                <div class="flex items-center gap-3 group/item">
                  <span class="font-mono text-xs text-muted/60 w-4 pointer-events-none">
                    0{idx + 1}
                  </span>
                  <a
                    href={`/posts/${post.id}/`}
                    class="text-sm text-base-text-light hover:text-primary-text transition-colors line-clamp-1 block"
                  >
                    {post.title}
                  </a>
                </div>
              ))}
            </div>

            <div class="mt-auto pt-4 flex items-center justify-between text-xs text-muted border-t border-base-border/30 pointer-events-none">
              <span class="opacity-80">
                {label.total > 3 ? `+ 还有 ${label.total - 3} 篇` : '查看全部'}
              </span>
              <div class="flex items-center gap-1 font-medium text-primary-text opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                进入分类 <div class="i-carbon-arrow-right" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { allLabels, allPosts } from '@/utils/data';
import { createCategorySlug } from '@/utils/slug';

const labels = allLabels
  .map((label) => {
    const total = allPosts.filter((post) =>
      post.labels.some((l) => l.name === label.name),
    ).length;

    return {
      ...label,
      slug: createCategorySlug(label.name),
      total,
    };
  })
  .sort((a, b) => b.total - a.total);
---

<Layout title="文章分类">
  <div class="py-4">
    <header class="mb-12 pb-8 border-b border-base-border/50">
      <h1 class="text-3xl font-extrabold mb-4 tracking-tight text-base-text">
        分类
      </h1>
      <p class="text-muted leading-relaxed">
        文章标签索引，共 {labels.length} 个分类
      </p>
    </header>

    <div class="flex flex-wrap gap-4 md:gap-5">
      {
        labels.map((label) => (
          <a
            href={`/category/${label.slug}/`}
            class="group inline-flex items-center gap-2.5 px-5 py-3 rounded-full border border-base-border/60 bg-base-bg hover:border-primary/40 hover:bg-base-fill hover:shadow-sm hover:-translate-y-0.5 transition-all duration-300"
          >
            <span
              class="w-2.5 h-2.5 rounded-full shrink-0"
              style={`background-color: #${label.color}`}
            />
            <span class="text-[15px] font-medium text-base-text group-hover:text-primary-text transition-colors">
              {label.name}
            </span>
            <span class="ml-1 text-xs font-mono font-bold text-muted bg-base-border/40 px-2 py-0.5 rounded-full group-hover:bg-primary-subtle group-hover:text-primary-text transition-colors">
              {label.total}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { allLabels } from '../../utils/data';

const labels = allLabels;
---

<Layout title="文章分类">
	<div class="mx-auto py-4">
		<header class="mb-10 pb-8 border-b border-gray-100 dark:border-gray-800">
			<h1 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight">分类</h1>
			<p class="text-gray-500 dark:text-gray-400">文章标签索引</p>
		</header>

		<div class="flex flex-wrap gap-3">
			{labels.map(label => (
				<a 
					href={`/category/${label.name}`} 
					class="px-4 py-2 rounded-full border border-gray-200 dark:border-gray-800 hover:border-primary/50 hover:text-primary transition-all flex items-center gap-2 bg-white dark:bg-hex-121212 text-sm font-medium"
				>
					<span class="w-2 h-2 rounded-full" style={`background-color: #${label.color}`}></span>
					<span>{label.name}</span>
				</a>
			))}
		</div>
	</div>
</Layout>

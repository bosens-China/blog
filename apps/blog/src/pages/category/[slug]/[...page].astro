---
import Layout from '@/layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import BackButton from '@/components/common/BackButton.astro';
import Pagination from '@/components/common/Pagination.astro';
import { allLabels, sortedPosts } from '@/utils/data';
import type { Page } from 'astro';
import type { Post } from '@/utils/data';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return allLabels.flatMap((label) => {
    const postsWithLabel = sortedPosts.filter((post) =>
      post.labels.some((l) => l.name === label.name),
    );
    const result = paginate(postsWithLabel, {
      params: { slug: label.name },
      props: { label },
      pageSize: 10,
    });

    return result.map((res: any) => {
      const p = res.params?.page;
      return {
        ...res,
        params: {
          ...res.params,
          // 如果是第一页(undefined 或 1)，设为 undefined 以匹配根路径
          page: !p || p === 1 || p === '1' ? undefined : String(p),
        },
      };
    });
  });
}

interface Label {
  name: string;
  color: string;
}

interface Props {
  page: Page<Post>;
  label: Label;
}

const { page, label } = Astro.props;
---

<Layout title={`分类: ${label.name} - 第 ${page.currentPage} 页`}>
  <div class="max-w-4xl mx-auto py-8">
    <BackButton href="/category/" text="返回分类列表" />

    <header class="mb-8 mt-8 pb-8 border-b border-base-border">
      <div class="flex items-center gap-4">
        <span
          class="w-4 h-4 rounded-full"
          style={`background-color: #${label.color}`}></span>
        <h1
          class="text-2xl md:text-3xl font-bold tracking-tight text-base-text"
        >
          {label.name}
        </h1>
      </div>
      <p class="text-sm mt-4 text-base-text-light">
        共 {page.total} 篇文章
      </p>
    </header>

    <div class="space-y-4">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      baseUrl={`/category/${label.name}`}
    />
  </div>
</Layout>

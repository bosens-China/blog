---
import type { Post } from '@/utils/data';
import { siteMeta } from '@/utils/data';
import PostTags from './PostTags.astro';
import { generateResponsiveImageAttrs } from '@/utils/image';
import { formatDate } from '@/utils/date';

interface Props {
  post: Post;
  hideSeries?: boolean;
}

const { post, hideSeries = false } = Astro.props;
const date = formatDate(post.created_at);

// 优先使用 AI 生成的 SEO 描述，如果没有则留空，保持页面整洁
const summary = siteMeta.posts_meta[post.id]?.seo?.description || '';

const images = post.images?.slice(0, 3) || [];
---

<article
  class="relative flex flex-col gap-3 py-10 border-b border-base-border last:border-none"
>
  <h2
    class="text-xl md:text-2xl font-bold leading-snug text-base-text hover:text-primary-text transition-colors order-1"
  >
    <a
      href={`/posts/${post.id}/`}
      class="static before:absolute before:inset-0"
    >
      {post.title}
    </a>
  </h2>
  <p
    class="text-sm md:text-base leading-relaxed line-clamp-2 text-base-text-light order-2"
  >
    {summary}
  </p>

  {
    images.length > 0 && (
      <div
        class={`grid gap-3 mt-3 order-3 ${
          images.length === 1
            ? 'grid-cols-1 md:grid-cols-3'
            : 'grid-cols-2 md:grid-cols-3'
        }`}
      >
        {images.map((img, index) => {
          const isError = img === '/error.svg';
          const isThree = images.length === 3;
          const isFirst = index === 0;

          // 3张图时，第一张在移动端跨2列 (全宽)，PC端占1列 (1/3)
          const colSpanClass =
            isThree && isFirst ? 'col-span-2 md:col-span-1' : 'col-span-1';

          // 逻辑尺寸判断：是否在移动端占据全宽
          const isFullWidthOnMobile = images.length === 1 || (isThree && isFirst);
          const requestWidth = isFullWidthOnMobile ? 800 : 400;
          
          // 精准的 sizes 属性 (适配 2K/4K 屏)
          // Desktop (>1024px): 容器限制 max-w-4xl，3列布局图片约为 300px。设置 320px 留富余。
          // Tablet (768-1024px): 33vw
          // Mobile (<768px): 100vw (全宽) 或 50vw (半宽)
          const sizes = isFullWidthOnMobile
            ? '(min-width: 1024px) 320px, (min-width: 768px) 33vw, 100vw'
            : '(min-width: 1024px) 320px, (min-width: 768px) 33vw, 50vw';

          const { src, srcset, webpSrcset } = generateResponsiveImageAttrs(
            img,
            requestWidth,
            'crop',
            1.6,
          );

          return (
            <div
              class={`relative rounded-xl overflow-hidden aspect-[16/10] bg-base-border/20 border border-base-border/50 ${colSpanClass}`}
            >
              <picture>
                {webpSrcset && <source srcset={webpSrcset} type="image/webp" />}
                <img
                  src={src}
                  srcset={srcset || undefined}
                  sizes={sizes}
                  alt={isError ? '图片加载失败' : ''}
                  title={isError ? '图片加载失败' : ''}
                  class="absolute inset-0 w-full h-full object-cover post-card-image"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          );
        })}
      </div>
    )
  }

  <div
    class="flex items-center justify-between mt-2 relative z-20 text-base-text-light order-4"
  >
    <PostTags post={post} hideSeries={hideSeries} />
    <time datetime={post.created_at} class="text-xs font-mono">{date}</time>
  </div>
</article>

<script>
  import { gsap } from 'gsap';

  function initAnimations() {
    const images = document.querySelectorAll('.post-card-image');

    images.forEach((img) => {
      // 避免重复绑定
      if ((img as any)._gsapBound) return;
      (img as any)._gsapBound = true;

      const onEnter = () => {
        gsap.to(img, {
          scale: 1.05,
          duration: 0.4,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      };

      const onLeave = () => {
        gsap.to(img, {
          scale: 1,
          duration: 0.4,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      };

      img.addEventListener('mouseenter', onEnter);
      img.addEventListener('mouseleave', onLeave);
    });
  }

  // 初始加载
  initAnimations();

  // 视图切换重新加载
  document.addEventListener('astro:page-load', initAnimations);
</script>

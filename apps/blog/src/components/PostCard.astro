---
import type { Post } from '@/utils/data';
import { siteMeta } from '@/utils/data';
import PostTags from './PostTags.astro';
import { generateResponsiveImageAttrs } from '@/utils/image';
import { formatDate } from '@/utils/date';

interface Props {
  post: Post;
  hideSeries?: boolean;
}

const { post, hideSeries = false } = Astro.props;
const date = formatDate(post.created_at);

// 优先使用 AI 生成的 SEO 描述，如果没有则留空，保持页面整洁
const summary = siteMeta.posts_meta[post.id]?.seo?.description || '';

const images = post.images?.slice(0, 3) || [];
---

<article
  class="relative flex flex-col gap-3 py-10 border-b border-base-border last:border-none"
>
  <div class="flex flex-col gap-2">
    <h2
      class="text-xl md:text-2xl font-bold leading-snug text-base-text hover:text-primary-text transition-colors"
    >
      <a
        href={`/posts/${post.id}/`}
        class="static before:absolute before:inset-0"
      >
        {post.title}
      </a>
    </h2>
    <p
      class="text-sm md:text-base leading-relaxed line-clamp-2 text-base-text-light"
    >
      {summary}
    </p>
  </div>

  {
    images.length > 0 && (
      <div class="grid grid-cols-3 gap-3 mt-3">
        {images.map((img) => {
          const isError = img === '/error.svg';
          const { src, srcset, webpSrcset } = generateResponsiveImageAttrs(
            img,
            400,
            'crop',
            1.6,
          );

          const sizes = '(max-width: 768px) 33vw, 33vw';

          return (
            <div class="relative rounded-xl overflow-hidden aspect-[16/10] bg-base-border/20 border border-base-border/50">
              <picture>
                {/* 优先加载 WebP */}
                {webpSrcset && <source srcset={webpSrcset} type="image/webp" />}
                {/* 兜底加载 JPG */}
                <img
                  src={src}
                  srcset={srcset || undefined}
                  sizes={sizes}
                  alt={isError ? '图片加载失败' : ''}
                  title={isError ? '图片加载失败' : ''}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          );
        })}
      </div>
    )
  }

  <div
    class="flex items-center justify-between mt-2 relative z-20 text-base-text-light"
  >
    <PostTags post={post} hideSeries={hideSeries} />
    <time datetime={post.created_at} class="text-xs font-mono">{date}</time>
  </div>
</article>

---
interface Props {
  /** 测量内容高度的选择器，默认 article */
  container?: string;
  /** 是否与 Ask AI 按钮堆叠（文章详情页） */
  stacked?: boolean;
}

const { container = 'article', stacked = false } = Astro.props;
---

<button
  type="button"
  class:list={[
    'back-to-top btn-floating z-30 opacity-0 pointer-events-none translate-y-4',
    'right-[max(1.5rem,env(safe-area-inset-right,0px))] md:right-8',
    stacked
      ? 'bottom-[max(4.5rem,calc(env(safe-area-inset-bottom,0px)+3.5rem))] md:bottom-[5.25rem]'
      : 'bottom-[max(1.5rem,env(safe-area-inset-bottom,0px))] md:bottom-8',
  ]}
  data-container={container}
  aria-label="返回顶部"
  title="返回顶部"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="i-carbon-arrow-up w-4.5 h-4.5"></div>
</button>

<style>
  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top.is-eligible:not(.is-visible) {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1rem);
  }
</style>

<script>
  const CONTENT_OVERFLOW = 300;
  const SCROLL_OFFSET = 400;

  let cleanup: (() => void) | null = null;

  function initBackToTop() {
    cleanup?.();

    const button = document.querySelector<HTMLButtonElement>('.back-to-top');
    if (!button) return;

    const containerSelector = button.dataset.container || 'article';
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const getContainer = () =>
      document.querySelector<HTMLElement>(containerSelector);

    const isEligible = () => {
      const container = getContainer();
      if (!container) return false;
      return container.scrollHeight - window.innerHeight > CONTENT_OVERFLOW;
    };

    const getScrollThreshold = () =>
      Math.min(SCROLL_OFFSET, window.innerHeight * 0.5);

    const setVisible = (visible: boolean) => {
      button.classList.toggle('is-visible', visible);
      button.setAttribute('aria-hidden', visible ? 'false' : 'true');
      button.tabIndex = visible ? 0 : -1;
    };

    const update = () => {
      const eligible = isEligible();
      button.classList.toggle('is-eligible', eligible);

      if (!eligible) {
        button.hidden = true;
        setVisible(false);
        return;
      }

      button.hidden = false;
      setVisible(window.scrollY > getScrollThreshold());
    };

    const scrollToTop = () => {
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? 'instant' : 'smooth',
      });
    };

    const onScroll = () => update();
    const onResize = () => update();

    button.addEventListener('click', scrollToTop);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });

    update();

    cleanup = () => {
      button.removeEventListener('click', scrollToTop);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      button.hidden = true;
      button.classList.remove('is-visible', 'is-eligible');
      setVisible(false);
    };
  }

  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>

---
interface Props {
  /** 测量内容高度的选择器，默认 article */
  container?: string;
  /** 是否与 Ask AI 按钮堆叠（文章详情页） */
  stacked?: boolean;
}

const { container = 'article', stacked = false } = Astro.props;
---

<button
  type="button"
  class:list={[
    'back-to-top group fixed z-30 flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-base-bg border border-base-border text-base-text-light shadow-sm hover:text-primary hover:border-primary/50 hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 opacity-0 pointer-events-none translate-y-4',
    stacked && 'back-to-top--stacked',
  ]}
  data-container={container}
  aria-label="返回顶部"
  aria-hidden="true"
  tabindex="-1"
>
  <div
    class="i-carbon-arrow-up w-5 h-5 transition-transform group-hover:scale-110"
  >
  </div>
  <span
    class="absolute -top-10 scale-0 group-hover:scale-100 transition-transform bg-base-text text-base-bg text-xs px-2 py-1 rounded shadow-sm opacity-90 whitespace-nowrap font-mono tracking-tight pointer-events-none"
  >
    返回顶部
  </span>
</button>

<style>
  .back-to-top {
    right: max(1.5rem, env(safe-area-inset-right, 0px));
    bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
  }

  .back-to-top--stacked {
    bottom: max(6rem, calc(env(safe-area-inset-bottom, 0px) + 4rem));
  }

  @media (min-width: 768px) {
    .back-to-top {
      right: 2rem;
      bottom: 4rem;
    }

    .back-to-top--stacked {
      bottom: 7.5rem;
    }
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top.is-eligible:not(.is-visible) {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1rem);
  }
</style>

<script>
  const CONTENT_OVERFLOW = 300;
  const SCROLL_OFFSET = 400;

  let cleanup: (() => void) | null = null;

  function initBackToTop() {
    cleanup?.();

    const button = document.querySelector<HTMLButtonElement>('.back-to-top');
    if (!button) return;

    const containerSelector = button.dataset.container || 'article';
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const getContainer = () =>
      document.querySelector<HTMLElement>(containerSelector);

    const isEligible = () => {
      const container = getContainer();
      if (!container) return false;
      return container.scrollHeight - window.innerHeight > CONTENT_OVERFLOW;
    };

    const getScrollThreshold = () =>
      Math.min(SCROLL_OFFSET, window.innerHeight * 0.5);

    const setVisible = (visible: boolean) => {
      button.classList.toggle('is-visible', visible);
      button.setAttribute('aria-hidden', visible ? 'false' : 'true');
      button.tabIndex = visible ? 0 : -1;
    };

    const update = () => {
      const eligible = isEligible();
      button.classList.toggle('is-eligible', eligible);

      if (!eligible) {
        button.hidden = true;
        setVisible(false);
        return;
      }

      button.hidden = false;
      setVisible(window.scrollY > getScrollThreshold());
    };

    const scrollToTop = () => {
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? 'instant' : 'smooth',
      });
    };

    const onScroll = () => update();
    const onResize = () => update();

    button.addEventListener('click', scrollToTop);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });

    update();

    cleanup = () => {
      button.removeEventListener('click', scrollToTop);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      button.hidden = true;
      button.classList.remove('is-visible', 'is-eligible');
      setVisible(false);
    };
  }

  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>

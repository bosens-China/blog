<footer class="border-t border-base-border py-12 mt-auto text-base-text-light">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="flex flex-col gap-4 items-center">
      <div class="flex items-center gap-4">
        <a
          href="/rss.xml"
          class="hover:text-primary-text transition-colors"
          title="RSS 订阅"
          aria-label="RSS 订阅"
        >
          <div class="i-carbon-rss w-5 h-5"></div>
        </a>
      </div>

      <p class="text-sm font-mono opacity-50 tracking-widest uppercase">
        © {new Date().getFullYear()} Xiaowo's Blog. All rights reserved.
      </p>

      <div class="flex items-center gap-1 text-xs opacity-60">
        <span>Built with</span>
        <a
          href="https://astro.build"
          target="_blank"
          class="hover:text-primary-text underline decoration-dotted">Astro</a
        >
        <span>&</span>
        <span class="text-red-400">❤</span>
      </div>
    </div>
  </div>
</footer>

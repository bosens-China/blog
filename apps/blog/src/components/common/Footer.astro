---
import { sortedPosts } from '@/utils/data';
import { getYear } from '@/utils/date';
import { routes } from '@/utils/routes';
import { icp, license } from '@/utils/site';

interface FooterLink {
  label: string;
  href: string;
}

const links: FooterLink[] = [
  { label: '分类', href: routes.categories() },
  { label: 'RSS', href: routes.rss() },
];

const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };

// 版权起始年取最早一篇文章，与当前年相同时只显示一个年份
const startYear = getYear(sortedPosts.at(-1)?.created_at);
const currentYear = getYear(new Date());
const copyrightYears =
  startYear && startYear !== currentYear
    ? `${startYear}–${currentYear}`
    : currentYear;
---

<footer class="mt-auto pt-16 pb-10 text-sm text-base-text-light">
  <div class="site-container">
    <!-- 移动端链接在上、版权在下；sm 以上版权居左、链接居右 -->
    <div
      class="pt-8 flex flex-col gap-4 sm:flex-row-reverse sm:items-start sm:justify-between"
    >
      <nav class="flex items-center gap-x-3.5 sm:gap-x-4 text-sm">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-base-text-light hover:text-base-text transition-colors duration-150"
            >
              {link.label}
            </a>
          ))
        }
        <span class="text-base-border/70 select-none text-xs" aria-hidden="true"
          >|</span
        >
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex items-center justify-center w-8.5 h-8.5 rounded-lg text-base-text-light hover:text-base-text hover:bg-base-fill/50 transition-colors duration-150 cursor-pointer"
          aria-label="主题：跟随系统，点击切换为浅色"
          title="跟随系统"
        >
          <span id="theme-icon" class="i-carbon-screen w-4 h-4"></span>
        </button>
      </nav>

      <div
        class="flex flex-col gap-1 text-xs tabular-nums text-base-text-light"
      >
        <p>
          © {copyrightYears} 小蜗 ·{' '}
          <a
            href={license.url}
            class="text-base-text-light hover:text-base-text transition-colors duration-150 underline underline-offset-2 decoration-base-border/60 hover:decoration-base-text"
            {...externalAttrs}
          >
            {license.name}
          </a>
        </p>
        <a
          href={icp.url}
          class="w-fit text-base-text-light hover:text-base-text transition-colors duration-150"
          {...externalAttrs}
        >
          {icp.number}
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  let cleanup: (() => void) | null = null;

  const THEME_LABEL = { auto: '跟随系统', light: '浅色', dark: '深色' };
  const THEME_ICON = {
    auto: 'i-carbon-screen',
    light: 'i-carbon-sun',
    dark: 'i-carbon-moon',
  };
  const NEXT_THEME = { auto: 'light', light: 'dark', dark: 'auto' } as const;

  type Theme = keyof typeof THEME_LABEL;

  function initThemeToggle() {
    cleanup?.();

    const button = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!button || !icon) return;

    const currentTheme = (): Theme => {
      const theme = window.getTheme();
      return theme in THEME_LABEL ? (theme as Theme) : 'auto';
    };

    const updateTheme = () => {
      const theme = currentTheme();
      const label = THEME_LABEL[theme];
      icon.className = `${THEME_ICON[theme]} w-4 h-4`;
      button.setAttribute(
        'aria-label',
        `主题：${label}，点击切换为${THEME_LABEL[NEXT_THEME[theme]]}`,
      );
      button.title = label;
    };

    const toggleTheme = () => {
      const next = NEXT_THEME[currentTheme()];
      localStorage.setItem('theme', next);
      window.applyTheme(next);
    };

    button.addEventListener('click', toggleTheme);
    window.addEventListener('theme-changed', updateTheme);
    updateTheme();

    cleanup = () => {
      button.removeEventListener('click', toggleTheme);
      window.removeEventListener('theme-changed', updateTheme);
    };
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>

---
import { about, authorGithub } from '@/utils/data';

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const links: FooterLink[] = [
  ...(about.visible ? [{ label: '关于我', href: '/about/' }] : []),
  { label: '分类', href: '/categories/' },
  { label: 'GitHub', href: authorGithub, external: true },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="mt-auto pt-16 pb-10 text-base-text-light">
  <div class="max-w-3xl mx-auto px-5 sm:px-6">
    <div
      class="pt-10 border-t border-base-border flex flex-col items-center gap-4 text-center"
    >
      <nav
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm"
      >
        {
          links.map((link) => (
            <>
              <a
                href={link.href}
                class="link-muted"
                {...(link.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {link.label}
              </a>
              <span aria-hidden="true" class="opacity-50">
                ·
              </span>
            </>
          ))
        }
        <button
          id="theme-toggle"
          type="button"
          class="link-muted inline-flex items-center cursor-pointer"
          aria-label="主题：跟随系统，点击切换为浅色"
          title="跟随系统"
        >
          <span id="theme-icon" class="i-carbon-contrast w-4 h-4"></span>
        </button>
      </nav>

      <div class="flex flex-col items-center gap-1 text-xs">
        <p>© {new Date().getFullYear()} Xiaowo's Blog. 保留所有权利</p>
        <p class="opacity-60">
          使用{' '}
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-base-text transition-colors">Astro</a
          >{' '}
          ♥ 构建
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  let cleanup: (() => void) | null = null;

  const THEME_LABEL = { auto: '跟随系统', light: '浅色', dark: '深色' };
  const THEME_ICON = {
    auto: 'i-carbon-contrast',
    light: 'i-carbon-sun',
    dark: 'i-carbon-moon',
  };
  const NEXT_THEME = { auto: 'light', light: 'dark', dark: 'auto' } as const;

  type Theme = keyof typeof THEME_LABEL;

  function initThemeToggle() {
    cleanup?.();

    const button = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!button || !icon) return;

    const currentTheme = (): Theme => {
      const theme = window.getTheme();
      return theme in THEME_LABEL ? (theme as Theme) : 'auto';
    };

    const updateTheme = () => {
      const theme = currentTheme();
      const label = THEME_LABEL[theme];
      icon.className = `${THEME_ICON[theme]} w-4 h-4`;
      button.setAttribute(
        'aria-label',
        `主题：${label}，点击切换为${THEME_LABEL[NEXT_THEME[theme]]}`,
      );
      button.title = label;
    };

    const toggleTheme = () => {
      const next = NEXT_THEME[currentTheme()];
      localStorage.setItem('theme', next);
      window.applyTheme(next);
    };

    button.addEventListener('click', toggleTheme);
    window.addEventListener('theme-changed', updateTheme);
    updateTheme();

    cleanup = () => {
      button.removeEventListener('click', toggleTheme);
      window.removeEventListener('theme-changed', updateTheme);
    };
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>

---
interface Props {
  href: string;
  text: string;
}

const { href, text } = Astro.props;
---

<a
  href={href}
  class="group mb-4 inline-flex items-center gap-1 text-sm link-muted"
>
  <span
    aria-hidden="true"
    class="transition-transform group-hover:-translate-x-0.5">←</span
  >
  {text}
</a>

---
interface Props {
	href: string;
	text?: string;
}

const { href, text } = Astro.props;
---
<a 
	href={href} 
	class="inline-flex items-center gap-2 px-3 py-1.5 -ml-3 text-sm font-medium text-base-text-light hover:text-primary hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-all duration-200 group"
>
	<div class="i-carbon-arrow-left w-4 h-4 group-hover:-translate-x-1 transition-transform"></div>
	{text || <slot />}
</a>

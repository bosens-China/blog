---
interface Props {
  title: string;
  subtitle?: string | undefined;
}

const { title, subtitle } = Astro.props;
const hasSubtitleSlot = Astro.slots.has('subtitle');
const hasSubtitle = Boolean(subtitle || hasSubtitleSlot);
---

<header class="mb-8 sm:mb-10">
  <slot name="before" />
  <h1
    class="text-2xl sm:text-[1.75rem] font-semibold leading-snug text-base-text"
  >
    {title}
  </h1>
  {
    hasSubtitle && (
      <div class="mt-2 flex items-center gap-2 text-sm leading-relaxed text-base-text-light flex-wrap">
        {subtitle && <span>{subtitle}</span>}
        <slot name="subtitle" />
      </div>
    )
  }
  <slot />
</header>

---
import Search from '@/components/Search';
import { navItems, isNavActive } from '@/utils/nav';

const { pathname } = Astro.url;
---

<header
  class="sticky top-0 z-40 w-full bg-base-bg/85 backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div
    class="max-w-3xl mx-auto px-5 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-4"
  >
    <a
      href="/"
      class="inline-flex shrink-0 items-center gap-2 text-base sm:text-lg font-semibold text-base-text transition-opacity hover:opacity-80"
    >
      <img
        src="/favicon.svg"
        alt=""
        width="24"
        height="24"
        class="w-6 h-6 dark:invert"
      />
      <span>小蜗</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-6">
      {import.meta.env.DEV ? null : <Search client:only="react" />}

      <nav class="flex items-center gap-4 sm:gap-6 text-sm sm:text-[15px]">
        {
          navItems.map((item) => {
            const active = isNavActive(item, pathname);
            return (
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'transition-colors',
                  active
                    ? 'text-base-text font-medium'
                    : 'text-base-text-light hover:text-base-text',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</header>

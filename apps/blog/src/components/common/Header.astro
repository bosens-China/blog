---
import { authorGithub, siteMeta, about } from '@/utils/data';
import Search from '@/components/Search';

const hasColumns = (siteMeta.columns || []).length > 0;
const showAbout = about.visible;
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-base-bg/70 border-b border-base-border/50"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a
          href="/page/1/"
          class="text-xl font-extrabold tracking-tight hover:text-primary-text transition-colors text-base-text"
          >Blog</a
        >
        <nav
          class="hidden md:flex items-center gap-6 text-sm font-medium text-base-text-light"
        >
          <a href="/page/1/" class="hover:text-primary-text transition-colors"
            >最新文章</a
          >
          <a href="/category/" class="hover:text-primary-text transition-colors"
            >分类</a
          >
          {
            hasColumns && (
              <a
                href="/column/"
                class="hover:text-primary-text transition-colors"
              >
                专栏
              </a>
            )
          }
          <a href="/weekly/" class="hover:text-primary-text transition-colors"
            >GitHub 一周热点</a
          >
          {
            showAbout && (
              <a
                href="/about/"
                class="hover:text-primary-text transition-colors"
              >
                关于我
              </a>
            )
          }
        </nav>
      </div>

      <div class="flex items-center gap-3 text-base-text-light">
        {import.meta.env.DEV ? null : <Search client:only="react" />}

        <button
          id="theme-toggle"
          class="h-9 w-9 flex items-center justify-center rounded-lg hover:bg-base-hover transition-colors focus:outline-none"
          aria-label="Toggle Theme"
        >
          <div id="theme-icon" class="i-carbon-laptop w-5 h-5"></div>
        </button>

        <a
          href={authorGithub}
          target="_blank"
          rel="noopener noreferrer"
          class="h-9 w-9 flex items-center justify-center rounded-lg hover:bg-base-hover transition-colors hidden md:flex"
          title="GitHub"
          aria-label="GitHub Profile"
        >
          <div class="i-carbon-logo-github w-5 h-5"></div>
        </a>

        <button
          id="menu-toggle"
          class="md:hidden h-9 w-9 flex items-center justify-center rounded-lg hover:bg-base-hover transition-colors focus:outline-none"
          aria-label="Toggle Menu"
        >
          <div class="i-carbon-menu w-5 h-5"></div>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-base-border backdrop-blur bg-base-bg/95 absolute w-full left-0 shadow-lg z-50"
  >
    <nav
      class="flex flex-col p-4 gap-1 text-sm font-medium text-base-text-light"
    >
      <a
        href="/page/1/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >最新文章</a
      >
      <a
        href="/category/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >分类</a
      >
      {
        hasColumns && (
          <a
            href="/column/"
            class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
          >
            专栏
          </a>
        )
      }
      <a
        href="/weekly/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >GitHub 一周热点</a
      >
      {
        showAbout && (
          <a
            href="/about/"
            class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
          >
            关于我
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  function initHeader() {
    // 清理之前的全局监听器
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');

    // 移动端菜单切换
    const toggleMenu = () => {
      mobileMenu?.classList.toggle('hidden');
    };
    menuToggle?.addEventListener('click', toggleMenu);

    // 点击外部关闭菜单 (全局监听器)
    const handleOutsideClick = (e: MouseEvent) => {
      if (
        !menuToggle?.contains(e.target as Node) &&
        !mobileMenu?.contains(e.target as Node)
      ) {
        mobileMenu?.classList.add('hidden');
      }
    };
    document.addEventListener('click', handleOutsideClick);

    // 更新图标函数
    const updateIcon = (theme: string) => {
      if (!themeIcon) return;
      themeIcon.className = '';
      if (theme === 'light') themeIcon.className = 'i-carbon-sun w-5 h-5';
      else if (theme === 'dark') themeIcon.className = 'i-carbon-moon w-5 h-5';
      else themeIcon.className = 'i-carbon-laptop w-5 h-5';
    };

    // 监听主题变化事件 (全局监听器)
    const handleThemeChange = (e: any) => {
      updateIcon(e.detail.theme);
    };
    window.addEventListener('theme-changed', handleThemeChange);

    // 初始化图标
    updateIcon(window.getTheme());

    // 切换主题按钮
    const toggleTheme = () => {
      const current = window.getTheme();
      let next = 'light';
      if (current === 'auto') next = 'light';
      else if (current === 'light') next = 'dark';
      else if (current === 'dark') next = 'auto';

      localStorage.setItem('theme', next);
      window.applyTheme(next);
    };
    themeToggle?.addEventListener('click', toggleTheme);

    // 注册清理函数
    cleanup = () => {
      document.removeEventListener('click', handleOutsideClick);
      window.removeEventListener('theme-changed', handleThemeChange);
      menuToggle?.removeEventListener('click', toggleMenu);
      themeToggle?.removeEventListener('click', toggleTheme);
    };
  }

  // 初次加载和 ClientRouter 切换后重新初始化
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

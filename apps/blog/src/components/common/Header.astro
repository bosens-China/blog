---
import { authorGithub, siteMeta } from '@/utils/data';

const hasColumns = (siteMeta.columns || []).length > 0;
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-base-bg/70 border-b border-base-border/50"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a
          href="/"
          class="text-xl font-extrabold tracking-tight hover:text-primary-text transition-colors text-base-text"
          >Blog</a
        >
        <nav
          class="hidden md:flex items-center gap-6 text-sm font-medium text-base-text-light"
        >
          <a href="/page/1/" class="hover:text-primary-text transition-colors"
            >最新文章</a
          >
          <a href="/category/" class="hover:text-primary-text transition-colors"
            >分类</a
          >
          {
            hasColumns && (
              <a
                href="/column/"
                class="hover:text-primary-text transition-colors"
              >
                专栏
              </a>
            )
          }
          <a href="/about/" class="hover:text-primary-text transition-colors"
            >关于我</a
          >
        </nav>
      </div>

      <div class="flex items-center gap-3 text-base-text-light">
        <button
          id="theme-toggle"
          class="p-2 rounded-lg hover:bg-base-hover transition-colors focus:outline-none"
          aria-label="Toggle Theme"
        >
          <div id="theme-icon" class="i-carbon-laptop w-5 h-5"></div>
        </button>

        <a
          href={authorGithub}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg hover:bg-base-hover transition-colors hidden md:block"
          title="GitHub"
          aria-label="GitHub Profile"
        >
          <div class="i-carbon-logo-github w-5 h-5"></div>
        </a>

        <button
          id="menu-toggle"
          class="md:hidden p-2 rounded-lg hover:bg-base-hover transition-colors focus:outline-none"
          aria-label="Toggle Menu"
        >
          <div class="i-carbon-menu w-5 h-5"></div>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-base-border backdrop-blur bg-base-bg/95 absolute w-full left-0 shadow-lg z-50"
  >
    <nav
      class="flex flex-col p-4 gap-1 text-sm font-medium text-base-text-light"
    >
      <a
        href="/page/1/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >最新文章</a
      >
      <a
        href="/category/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >分类</a
      >
      {
        hasColumns && (
          <a
            href="/column/"
            class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
          >
            专栏
          </a>
        )
      }
      <a
        href="/about/"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors"
        >关于我</a
      >
      <a
        href={authorGithub}
        target="_blank"
        rel="noopener noreferrer"
        class="p-3 rounded-lg hover:bg-base-hover hover:text-primary-text transition-colors flex items-center gap-2"
      >
        <div class="i-carbon-logo-github w-4 h-4"></div> GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');

    // 移动端菜单
    menuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // 点击外部关闭菜单
    document.addEventListener('click', (e) => {
      if (
        !menuToggle?.contains(e.target as Node) &&
        !mobileMenu?.contains(e.target as Node)
      ) {
        mobileMenu?.classList.add('hidden');
      }
    });

    // 更新图标函数
    const updateIcon = (theme: string) => {
      if (!themeIcon) return;
      themeIcon.className = '';
      if (theme === 'light') themeIcon.className = 'i-carbon-sun w-5 h-5';
      else if (theme === 'dark') themeIcon.className = 'i-carbon-moon w-5 h-5';
      else themeIcon.className = 'i-carbon-laptop w-5 h-5';
    };

    // 监听主题变化事件 (由 Layout 触发)
    window.addEventListener('theme-changed', (e: any) => {
      updateIcon(e.detail.theme);
    });

    // 初始化图标
    updateIcon(window.getTheme());

    // 切换主题按钮
    themeToggle?.addEventListener('click', () => {
      const current = window.getTheme();
      let next = 'light';
      if (current === 'auto') next = 'light';
      else if (current === 'light') next = 'dark';
      else if (current === 'dark') next = 'auto';

      localStorage.setItem('theme', next);
      window.applyTheme(next);
    });
  }

  // 初次加载和 ClientRouter 切换后重新初始化
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

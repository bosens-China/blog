---
import MarkdownIt from 'markdown-it';
import anchor from 'markdown-it-anchor';
// @ts-ignore
import taskLists from 'markdown-it-task-lists';
import { fromHighlighter } from '@shikijs/markdown-it';
import { getHighlighter } from '@/utils/highlighter';
import { generateResponsiveImageAttrs } from '@/utils/image';
import copyIcon from '@/icons/copy.svg?raw';
import checkIcon from '@/icons/check.svg?raw';

interface Props {
  content: string;
}

const { content } = Astro.props;

// 1. 初始化 MarkdownIt (单例模式在 Astro 组件内部每次请求都会运行，但 Astro 构建时是静态的)
const highlighter = await getHighlighter();
const md = MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
});

// 获取所有已加载的语言（Shiki 会自动处理别名，例如 js -> javascript）
const loadedLanguages = new Set(highlighter.getLoadedLanguages());

// --- Image 渲染规则 ---
md.renderer.rules.image = (tokens, idx, options, _env, self) => {
  const token = tokens[idx];
  if (!token) return '';

  const srcIndex = token.attrIndex('src');
  if (srcIndex >= 0) {
    const src = token.attrs?.[srcIndex]?.[1];
    let alt = token.content;
    let title = '';
    const titleIndex = token.attrIndex('title');
    if (titleIndex >= 0) {
      title = token.attrs?.[titleIndex]?.[1] || '';
    }

    if (!src) return self.renderToken(tokens, idx, options);

    // 如果后端已经将其替换为错误占位图
    const isError = src === '/error.svg';
    if (isError) {
      alt = '图片加载失败';
      title = '图片加载失败';
    }

    // 文章内的图片通常不需要裁剪，保持 fit 模式即可
    // layoutWidth 896 对应 max-w-4xl
    const {
      src: newSrc,
      srcset,
      webpSrcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 896, 'fit');

    if (!srcset) {
      return `<img src="${src}" alt="${alt}" title="${title}" loading="lazy">`;
    }

    // 增加了 class 样式，确保图片在文章中居中且不溢出
    return `
      <figure class="my-8">
        <picture>
          <source srcset="${webpSrcset}" sizes="${sizes}" type="image/webp">
          <source srcset="${srcset}" sizes="${sizes}" type="image/jpeg">
          <img src="${newSrc}" alt="${alt}" title="${title}" loading="lazy" class="w-full h-auto rounded-lg">
        </picture>
        ${alt ? `<figcaption class="text-center text-sm text-gray-500 mt-2">${alt}</figcaption>` : ''}
      </figure>
    `;
  }
  return self.renderToken(tokens, idx, options);
};

// 3. 配置插件
md.use(anchor, {
  tabIndex: false,
  permalink: anchor.permalink.ariaHidden({
    placement: 'before',
    symbol: '#',
    class: 'anchor-link',
  }),
});

md.use(taskLists, {
  label: true,
  labelAfter: true,
});

md.use(
  fromHighlighter(highlighter as any, {
    themes: {
      light: 'github-light',
      dark: 'github-dark',
    },
    defaultColor: false,
  }),
);

// 3.1 拦截并增强 Fence 渲染 (添加复制代码和语言标记)
// 保存 Shiki 注入的渲染函数
const shikiFence = md.renderer.rules.fence!;

md.renderer.rules.fence = (tokens, idx, options, env, self) => {
  const token = tokens[idx];
  if (!token) return '';

  // 获取语言 (取第一个单词)
  const lang = token.info?.trim().split(/\s+/)[0] || '';

  // Mermaid 图表支持
  if (lang === 'mermaid') {
    const content = token.content.trim();
    // 输出未处理的 mermaid 代码，交给前端脚本渲染
    // 使用 data-original 保存原始代码，避免重绘时丢失
    return `<div class="mermaid bg-base-bg p-4 rounded-lg overflow-x-auto flex justify-center my-6 border border-base-border" data-original="${encodeURIComponent(content)}">${content}</div>`;
  }

  // 调用 Shiki 生成高亮 HTML
  const html = shikiFence(tokens, idx, options, env, self);

  // 包装 HTML
  return `
    <div class="code-container not-prose">
      <div class="code-header">
        <div class="mac-buttons">
          <span class="mac-button close"></span>
          <span class="mac-button minimize"></span>
          <span class="mac-button maximize"></span>
        </div>
        <div class="code-actions">
          <span class="lang-badge">${lang}</span>
          <button class="copy-btn" aria-label="Copy code">
            ${copyIcon}
          </button>
        </div>
      </div>
      ${html}
    </div>
  `;
};

// 4. 渲染 Markdown
// 预处理代码块语言：如果 Shiki 不支持该语言，降级为 text，防止报错
let processedContent = content.replace(
  /```([a-zA-Z0-9_\-]+)/g,
  (_match, p1) => {
    const lang = p1.toLowerCase();
    if (lang === 'mermaid') return '```mermaid';
    // 检查语言是否已加载
    if (loadedLanguages.has(lang)) {
      return '```' + lang;
    }
    // 如果不支持，降级为 text（无高亮）
    return '```text';
  },
);

let html = md.render(processedContent);

// 5. 后处理：修复 HTML 标签形式的图片 (<img src="...">)
// 正则替换部分保持不变，逻辑是通用的
html = html.replace(
  /<img\s+([^>]*?)src=["']([^"']+)["']([^>]*?)>/gi,
  (match, beforeSrc, src, afterSrc) => {
    if (match.includes('srcset=') || match.includes('<picture')) return match;

    const {
      src: newSrc,
      srcset,
      webpSrcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 896, 'fit');

    const isError = src === '/error.svg';

    // 如果不是错误图片且没有 srcset，才返回原样
    if (!isError && !srcset) return match;

    const loadingAttr = match.includes('loading=') ? '' : ' loading="lazy"';
    const classAttr = match.includes('class=')
      ? ''
      : ' class="w-full h-auto rounded-lg"';

    let finalBeforeSrc = beforeSrc;
    let finalAfterSrc = afterSrc;

    if (isError) {
      // 移除原有的 alt 和 title 声明 (如果有)
      finalBeforeSrc = finalBeforeSrc
        .replace(/\balt=["'][^"']*["']/gi, '')
        .replace(/\btitle=["'][^"']*["']/gi, '');
      finalAfterSrc = finalAfterSrc
        .replace(/\balt=["'][^"']*["']/gi, '')
        .replace(/\btitle=["'][^"']*["']/gi, '');

      // 统一注入
      finalBeforeSrc += ' alt="图片加载失败" title="图片加载失败" ';

      // 对于错误图片，如果不走 picture 逻辑（无 srcset），直接返回修改后的 img
      if (!srcset) {
        return `<img ${finalBeforeSrc} src="${src}" ${finalAfterSrc} ${loadingAttr} ${classAttr}>`;
      }
    }

    return `
      <picture>
        <source srcset="${webpSrcset}" sizes="${sizes}" type="image/webp">
        <source srcset="${srcset}" sizes="${sizes}" type="image/jpeg">
        <img ${finalBeforeSrc} src="${newSrc}" srcset="${srcset}" sizes="${sizes}" ${finalAfterSrc} ${loadingAttr} ${classAttr}>
      </picture>
    `;
  },
);
---

<div
  class="prose dark:prose-invert max-w-none"
  data-check-icon={checkIcon}
  data-copy-icon={copyIcon}
>
  <Fragment set:html={html} />
</div>

<script>
  // --- Mermaid 渲染逻辑 ---
  const initMermaid = async () => {
    const graphs = document.querySelectorAll('.mermaid');
    if (graphs.length === 0) return;

    // 只有在检测到图表时才动态导入 mermaid，减少首屏 JS 体积
    const { default: mermaid } = await import('mermaid');

    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'dark' : 'default';

    mermaid.initialize({
      startOnLoad: false,
      theme,
      fontFamily: 'var(--font-sans)',
      securityLevel: 'loose',
      themeVariables: {
        fontFamily: 'var(--font-sans)',
        darkMode: isDark,
        background: isDark ? '#1e1e1e' : '#ffffff',
        primaryColor: isDark ? '#3b82f6' : '#2563eb',
        lineColor: isDark ? '#a0a0a0' : '#333333',
      },
    });

    for (const graph of graphs) {
      // 检查是否已经渲染过（通过 svg 判断），如果是则清空重绘（应对主题切换）
      if (graph.querySelector('svg')) {
        graph.innerHTML = '';
      }

      const originalContent = graph.getAttribute('data-original');
      if (!originalContent) continue;

      const content = decodeURIComponent(originalContent);

      try {
        const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
        // render 返回 { svg, bindFunctions }，我们需要 svg 字符串
        const { svg } = await mermaid.render(id, content);
        graph.innerHTML = svg;

        // 修复 ARIA role 问题
        const svgElement = graph.querySelector('svg');
        if (svgElement) {
          svgElement.setAttribute('role', 'img');
          svgElement.setAttribute('aria-label', 'Diagram');
        }
      } catch (e) {
        console.error('Mermaid render error:', e);
        graph.innerHTML = `<div class="text-red-500 text-xs p-2 border border-red-500 rounded bg-red-50/10 overflow-auto font-mono whitespace-pre-wrap">Mermaid Error:\n${e instanceof Error ? e.message : String(e)}</div>`;
      }
    }
  };

  // 监听主题切换，重新渲染
  window.addEventListener('theme-changed', () => {
    initMermaid();
  });

  // 页面加载和视图转换时初始化
  document.addEventListener('astro:page-load', initMermaid);

  // --- 原有的代码块复制逻辑 ---
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.copy-btn');
    const container = target.closest('.prose') as HTMLElement;

    if (!btn || !container) return;

    // 找到对应的代码块文本
    const codeContainer = btn.closest('.code-container');
    const pre = codeContainer?.querySelector('pre');
    const code = pre?.innerText; // 获取纯文本

    if (code) {
      try {
        await navigator.clipboard.writeText(code);

        // 从 data 属性获取图标
        const checkIcon = container.dataset.checkIcon || '';
        const copyIcon = container.dataset.copyIcon || '';

        // 成功反馈
        btn.innerHTML = checkIcon;
        btn.classList.add('text-green-500');

        setTimeout(() => {
          btn.innerHTML = copyIcon;
          btn.classList.remove('text-green-500');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    }
  });
</script>

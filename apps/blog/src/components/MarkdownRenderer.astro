---
import MarkdownIt from 'markdown-it';
import anchor from 'markdown-it-anchor';
// @ts-ignore
import taskLists from 'markdown-it-task-lists';
import { katex } from '@mdit/plugin-katex';
import { fromHighlighter } from '@shikijs/markdown-it';
import 'katex/dist/katex.min.css';
import { getHighlighter } from '@/utils/highlighter';
import { generateResponsiveImageAttrs } from '@/utils/image';
import { mediaPlugin } from '@/utils/markdown/media';
import { copiedLinkPlugin } from '@/utils/markdown/copiedLink';
import { katexOptions, markdownOptions } from '@/utils/markdown/options';
import { getLanguageLabel, isPlainTextLang } from '@/utils/markdown/codeLang';
import { renderDemo } from '@/utils/markdown/demo';
import { renderCodePreview } from '@/utils/markdown/codePreview';
import CodePreviewScript from '@/components/article/CodePreviewScript.astro';
import DiagramScript from '@/components/article/DiagramScript.astro';
import zoomInIcon from '@/icons/zoom-in.svg?raw';
import zoomOutIcon from '@/icons/zoom-out.svg?raw';
import DemoScript from '@/components/article/DemoScript.astro';
import AudioPlayerScript from '@/components/media/AudioPlayerScript.astro';
import copyIcon from '@/icons/copy.svg?raw';
import checkIcon from '@/icons/check.svg?raw';
import wrapIcon from '@/icons/wrap.svg?raw';
import noWrapIcon from '@/icons/no-wrap.svg?raw';

interface Props {
  content: string;
  afterFirstHeadingHtml?: string;
}

const { content, afterFirstHeadingHtml = '' } = Astro.props;

// 1. 初始化 MarkdownIt (单例模式在 Astro 组件内部每次请求都会运行，但 Astro 构建时是静态的)
const highlighter = await getHighlighter();
const md = MarkdownIt(markdownOptions);

// 获取所有已加载的语言（Shiki 会自动处理别名，例如 js -> javascript）
const loadedLanguages = new Set(highlighter.getLoadedLanguages());

// --- Image 渲染规则 ---
md.renderer.rules.image = (tokens, idx, options, _env, self) => {
  const token = tokens[idx];
  if (!token) return '';

  const srcIndex = token.attrIndex('src');
  if (srcIndex >= 0) {
    const src = token.attrs?.[srcIndex]?.[1];
    let alt = token.content;
    let title = '';
    const titleIndex = token.attrIndex('title');
    if (titleIndex >= 0) {
      title = token.attrs?.[titleIndex]?.[1] || '';
    }

    if (!src) return self.renderToken(tokens, idx, options);

    // 如果后端已经将其替换为错误占位图
    const isError = src === '/error.svg';
    if (isError) {
      alt = '图片加载失败';
      title = '图片加载失败';
    }

    // 文章内的图片通常不需要裁剪，保持 fit 模式即可
    // layoutWidth 768 对应 max-w-3xl
    const {
      src: newSrc,
      srcset,
      webpSrcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 768, 'fit');

    // 转义 alt/title，防止内容中的引号/尖括号闭合属性造成注入
    const safeAlt = md.utils.escapeHtml(alt);
    const safeTitle = md.utils.escapeHtml(title);

    if (!srcset) {
      return `<img src="${src}" alt="${safeAlt}" title="${safeTitle}" loading="lazy">`;
    }

    // 增加了 class 样式，确保图片在文章中居中且不溢出
    return `
      <figure class="my-8">
        <picture>
          <source srcset="${webpSrcset}" sizes="${sizes}" type="image/webp">
          <source srcset="${srcset}" sizes="${sizes}" type="image/jpeg">
          <img src="${newSrc}" alt="${safeAlt}" title="${safeTitle}" loading="lazy" class="w-full h-auto rounded-lg">
        </picture>
        ${alt ? `<figcaption class="text-center text-sm text-base-text-light mt-2">${safeAlt}</figcaption>` : ''}
      </figure>
    `;
  }
  return self.renderToken(tokens, idx, options);
};

// 3. 配置插件
md.use(copiedLinkPlugin);

md.use(anchor, {
  tabIndex: false,
  permalink: anchor.permalink.ariaHidden({
    placement: 'before',
    symbol: '#',
    class: 'anchor-link',
  }),
});

md.use(mediaPlugin);

md.use(taskLists, {
  label: true,
  labelAfter: true,
});

md.use(katex, katexOptions);

md.use(
  fromHighlighter(highlighter, {
    themes: {
      light: 'github-light',
      dark: 'github-dark',
    },
    defaultColor: false,
  }),
);

// 3.1 拦截并增强 Fence 渲染 (添加复制代码和语言标记)
// 保存 Shiki 注入的渲染函数
const shikiFence = md.renderer.rules.fence!;

md.renderer.rules.fence = (tokens, idx, options, env, self) => {
  const token = tokens[idx];
  if (!token) return '';

  // 获取语言 (取第一个单词)
  const lang = token.info?.trim().split(/\s+/)[0] || '';

  // 包装 HTML：标题栏与代码区同色无分隔，左侧语言名，右侧换行与复制
  const wrapped = isPlainTextLang(lang);
  const codeActions = `
    <button type="button" class="code-btn wrap-btn" aria-pressed="${wrapped}" aria-label="自动换行" title="${wrapped ? '取消自动换行' : '自动换行'}">
      <span class="icon-no-wrap" aria-hidden="true">${noWrapIcon}</span>
      <span class="icon-wrap" aria-hidden="true">${wrapIcon}</span>
    </button>
    <button type="button" class="code-btn copy-btn" aria-label="复制代码" title="复制代码">
      <span class="copy-icon" aria-hidden="true">${copyIcon}</span>
    </button>
  `;
  if (lang === 'mermaid') {
    env.hasDiagrams = true;
    const previewHtml = `<div class="overflow-auto max-h-[min(70vh,600px)]" data-diagram-viewport tabindex="0" aria-label="Mermaid 图表，可拖动或滚动查看"><div class="mermaid p-4" data-original="${encodeURIComponent(token.content.trim())}" data-scale="1">${md.utils.escapeHtml(token.content)}</div></div>`;
    const zoomActions = `
      <button type="button" class="code-btn" data-diagram-zoom="-0.25" aria-label="缩小图表" title="缩小图表">${zoomOutIcon}</button>
      <button type="button" class="code-btn" data-diagram-zoom="0.25" aria-label="放大图表" title="放大图表">${zoomInIcon}</button>`;
    return renderCodePreview(
      md,
      'Mermaid',
      previewHtml,
      `<pre><code>${md.utils.escapeHtml(token.content)}</code></pre>`,
      codeActions,
      zoomActions,
    );
  }

  const html = shikiFence(tokens, idx, options, env, self);
  const demoHtml = renderDemo(md, token.info, token.content, html, codeActions);
  if (demoHtml) {
    env.hasDemos = true;
    return demoHtml;
  }
  const codeHtml = `
    <div class="code-container not-prose${wrapped ? ' is-wrapped' : ''}">
      <div class="code-header">
        <span class="code-lang">${md.utils.escapeHtml(getLanguageLabel(lang))}</span>
        <div class="code-actions">
          ${codeActions}
        </div>
      </div>
      ${html}
    </div>
  `;
  return codeHtml;
};

// 4. 渲染 Markdown
// 预处理代码块语言：如果 Shiki 不支持该语言，降级为 text，防止报错
// 仅匹配行首的围栏（允许最多 3 个缩进空格），避免误伤正文/行内出现的反引号；
// 同时支持 ``` 与 ~~~，并保留原始的缩进与围栏字符
let processedContent = content.replace(
  /^(\s{0,3})(```|~~~)([a-zA-Z0-9_\-]+)/gm,
  (_match, indent, fence, p1) => {
    const lang = p1.toLowerCase();
    if (lang === 'mermaid') return `${indent}${fence}mermaid`;
    // 检查语言是否已加载
    if (loadedLanguages.has(lang)) {
      return `${indent}${fence}${lang}`;
    }
    // 如果不支持，降级为 text（无高亮）
    return `${indent}${fence}text`;
  },
);

const renderEnv = { hasDemos: false, hasDiagrams: false };
let html = md.render(processedContent, renderEnv);

if (afterFirstHeadingHtml) {
  html = html.replace('</h1>', `</h1>${afterFirstHeadingHtml}`);
}

// 5. 后处理：修复 HTML 标签形式的图片 (<img src="...">)
// 正则替换部分保持不变，逻辑是通用的
html = html.replace(
  /<img\s+([^>]*?)src=["']([^"']+)["']([^>]*?)>/gi,
  (match, beforeSrc, src, afterSrc) => {
    if (match.includes('srcset=') || match.includes('<picture')) return match;

    const {
      src: newSrc,
      srcset,
      webpSrcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 768, 'fit');

    const isError = src === '/error.svg';

    // 如果不是错误图片且没有 srcset，才返回原样
    if (!isError && !srcset) return match;

    const loadingAttr = match.includes('loading=') ? '' : ' loading="lazy"';
    const classAttr = match.includes('class=')
      ? ''
      : ' class="w-full h-auto rounded-lg"';

    let finalBeforeSrc = beforeSrc;
    let finalAfterSrc = afterSrc;

    if (isError) {
      // 移除原有的 alt 和 title 声明 (如果有)
      finalBeforeSrc = finalBeforeSrc
        .replace(/\balt=["'][^"']*["']/gi, '')
        .replace(/\btitle=["'][^"']*["']/gi, '');
      finalAfterSrc = finalAfterSrc
        .replace(/\balt=["'][^"']*["']/gi, '')
        .replace(/\btitle=["'][^"']*["']/gi, '');

      // 统一注入
      finalBeforeSrc += ' alt="图片加载失败" title="图片加载失败" ';

      // 对于错误图片，如果不走 picture 逻辑（无 srcset），直接返回修改后的 img
      if (!srcset) {
        return `<img ${finalBeforeSrc} src="${src}" ${finalAfterSrc} ${loadingAttr} ${classAttr}>`;
      }
    }

    return `
      <picture>
        <source srcset="${webpSrcset}" sizes="${sizes}" type="image/webp">
        <source srcset="${srcset}" sizes="${sizes}" type="image/jpeg">
        <img ${finalBeforeSrc} src="${newSrc}" srcset="${srcset}" sizes="${sizes}" ${finalAfterSrc} ${loadingAttr} ${classAttr}>
      </picture>
    `;
  },
);
---

<div
  class="prose prose-neutral detail-content dark:prose-invert max-w-none [&>:first-child]:mt-0"
  data-check-icon={checkIcon}
  data-copy-icon={copyIcon}
>
  <Fragment set:html={html} />
</div>
<AudioPlayerScript />
{(renderEnv.hasDemos || renderEnv.hasDiagrams) && <CodePreviewScript />}
{renderEnv.hasDemos && <DemoScript />}
{renderEnv.hasDiagrams && <DiagramScript />}

<script>
  // --- 代码块自动换行切换 ---
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.wrap-btn');
    const codeContainer = btn?.closest('.code-container');
    if (!btn || !codeContainer) return;

    const wrapped = codeContainer.classList.toggle('is-wrapped');
    btn.setAttribute('aria-pressed', String(wrapped));
    btn.setAttribute('title', wrapped ? '取消自动换行' : '自动换行');
  });

  // --- 代码块复制逻辑 ---
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.copy-btn');
    const container = target.closest('.prose') as HTMLElement;

    if (!btn || !container) return;

    // 找到对应的代码块文本
    const codeContainer = btn.closest('.code-container');
    const pre = codeContainer?.querySelector('pre');
    const code = pre?.textContent; // 隐藏的演示代码标签也需要保留完整源码

    if (code) {
      try {
        await navigator.clipboard.writeText(code);

        // 从 data 属性获取图标
        const checkIcon = container.dataset.checkIcon || '';
        const copyIcon = container.dataset.copyIcon || '';

        // 成功反馈
        const icon = btn.querySelector('.copy-icon');
        if (!icon) return;
        icon.innerHTML = checkIcon;
        btn.setAttribute('aria-label', '已复制');
        btn.setAttribute('title', '已复制');
        btn.classList.add('is-copied');

        setTimeout(() => {
          icon.innerHTML = copyIcon;
          btn.setAttribute('aria-label', '复制代码');
          btn.setAttribute('title', '复制代码');
          btn.classList.remove('is-copied');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    }
  });
</script>

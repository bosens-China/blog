---
import MarkdownIt from 'markdown-it';
import anchor from 'markdown-it-anchor';
import { fromHighlighter } from '@shikijs/markdown-it';
import { getHighlighter } from '@/utils/highlighter';
import { generateResponsiveImageAttrs } from '@/utils/image';
import copyIcon from '@/icons/copy.svg?raw';
import checkIcon from '@/icons/check.svg?raw';

interface Props {
  content: string;
}

const { content } = Astro.props;

// 1. 初始化 MarkdownIt (单例模式在 Astro 组件内部每次请求都会运行，但 Astro 构建时是静态的)
const highlighter = await getHighlighter();
const md = MarkdownIt({
  html: true, // 允许 HTML 标签
  linkify: true,
  typographer: true,
});

// 2. 自定义 Markdown 图片语法 (![]) 渲染
const defaultImageRenderer =
  md.renderer.rules.image ||
  function (tokens, idx, options, _env, self) {
    return self.renderToken(tokens, idx, options);
  };

md.renderer.rules.image = (tokens, idx, options, env, self) => {
  const token = tokens[idx];
  const srcIndex = token.attrIndex('src');
  if (srcIndex >= 0) {
    const src = token.attrs![srcIndex][1];

    // 使用统一工具生成属性
    const {
      src: newSrc,
      srcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 896, 'fit');

    // 如果没有 srcset (如 svg/gif)，则只更新 src
    if (srcset && sizes) {
      token.attrPush(['srcset', srcset]);
      token.attrPush(['sizes', sizes]);
      token.attrPush(['loading', 'lazy']);
    }

    token.attrs![srcIndex][1] = newSrc;
  }
  return defaultImageRenderer(tokens, idx, options, env, self);
};

// 3. 配置插件
md.use(anchor, {
  permalink: anchor.permalink.ariaHidden({
    placement: 'before',
    symbol: '#',
    class: 'anchor-link',
  }),
});

md.use(
  fromHighlighter(highlighter as any, {
    themes: {
      light: 'github-light',
      dark: 'github-dark',
    },
    defaultColor: false,
  }),
);

// 3.1 拦截并增强 Fence 渲染 (添加复制代码和语言标记)
// 保存 Shiki 注入的渲染函数
const shikiFence = md.renderer.rules.fence!;

md.renderer.rules.fence = (tokens, idx, options, env, self) => {
  // 获取语言 (取第一个单词)
  const lang = tokens[idx].info.trim().split(/\s+/)[0] || '';

  // 调用 Shiki 生成高亮 HTML
  const html = shikiFence(tokens, idx, options, env, self);

  // 包装 HTML
  return `
    <div class="code-container not-prose">
      <div class="code-header">
        <span class="lang-badge">${lang}</span>
        <button class="copy-btn" aria-label="Copy code">
          ${copyIcon}
        </button>
      </div>
      ${html}
    </div>
  `;
};

// 4. 渲染 Markdown
// 预处理代码块语言大小写兼容
let html = md.render(
  content.replace(/```([a-zA-Z]+)/g, (_match, p1) => '```' + p1.toLowerCase()),
);

// 5. 后处理：修复 HTML 标签形式的图片 (<img src="...">)
// 这种图片 markdown-it 不会走 image rule，所以需要对生成的 HTML 进行正则替换
// 注意：这在构建时(Build Time)运行，是 Node.js 环境，完全不影响浏览器性能
html = html.replace(
  /<img\s+([^>]*?)src=["']([^"']+)["']([^>]*?)>/gi,
  (match, beforeSrc, src, afterSrc) => {
    // 防止重复处理 (例如已经被 markdown-it 处理过的)
    if (match.includes('srcset=')) return match;

    // 使用统一工具生成属性
    const {
      src: newSrc,
      srcset,
      sizes,
    } = generateResponsiveImageAttrs(src, 896, 'fit');

    // 如果不需要处理 (svg/gif)，直接返回（或者你可以选择返回 newSrc 如果它有清理逻辑）
    if (!srcset) return match;

    // 构建新标签
    let newTag = `<img ${beforeSrc} src="${newSrc}" ${afterSrc}`;

    newTag += ` srcset="${srcset}"`;
    newTag += ` sizes="${sizes}"`;

    // 确保有 lazy load
    if (!match.includes('loading=')) {
      newTag += ` loading="lazy"`;
    }

    newTag += `>`;
    return newTag;
  },
);
---

<div
  class="prose dark:prose-invert max-w-none"
  data-check-icon={checkIcon}
  data-copy-icon={copyIcon}
>
  <Fragment set:html={html} />
</div>

<script>
  // 处理代码块复制
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.copy-btn');
    const container = target.closest('.prose') as HTMLElement;

    if (!btn || !container) return;

    // 找到对应的代码块文本
    const codeContainer = btn.closest('.code-container');
    const pre = codeContainer?.querySelector('pre');
    const code = pre?.innerText; // 获取纯文本

    if (code) {
      try {
        await navigator.clipboard.writeText(code);

        // 从 data 属性获取图标
        const checkIcon = container.dataset.checkIcon || '';
        const copyIcon = container.dataset.copyIcon || '';

        // 成功反馈
        btn.innerHTML = checkIcon;
        btn.classList.add('text-green-500');

        setTimeout(() => {
          btn.innerHTML = copyIcon;
          btn.classList.remove('text-green-500');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    }
  });
</script>

---
import { siteMeta, getSeriesIdByName, type Post } from '../utils/data';

interface Props {
  post: Post;
  hideSeries?: boolean;
  class?: string;
}

const { post, hideSeries = false, class: className = '' } = Astro.props;

const postMeta = siteMeta.posts_meta[post.id.toString()];
const series = postMeta?.series;
const seriesId = series ? getSeriesIdByName(series) : null;
---

<div class={`flex flex-wrap items-center gap-3 text-sm relative z-20 ${className}`}>
  <!-- 专栏 (高亮显示) -->
  {!hideSeries && series && seriesId && (
    <a 
      href={`/column/${seriesId}`} 
      class="series-tag px-3 py-1 rounded-full bg-primary/10 hover:bg-primary/20 transition-colors font-medium text-xs relative"
    >
      {series}
    </a>
  )}

  <!-- 标签 (次级显示) -->
  {post.labels.map(label => (
    <a 
      href={`/category/${label.name}`}
      class="category-tag hover:text-primary transition-colors hover:underline decoration-primary/30 underline-offset-4 py-1 relative"
    >
      #{label.name}
    </a>
  ))}
</div>
<style>
    .series-tag {
        color: var(--c-primary);
    }
    .category-tag {
        color: var(--c-text-light);
    }
</style>
---
import { siteMeta, getSeriesIdByName, type Post } from '../utils/data';

interface Props {
  post: Post;
  hideSeries?: boolean;
  class?: string;
}

const { post, hideSeries = false, class: className = '' } = Astro.props;

const postMeta = siteMeta.posts_meta[post.id.toString()];
const series = postMeta?.series;
const seriesId = series ? getSeriesIdByName(series) : null;
---

<div class={`flex flex-wrap items-center gap-3 text-sm ${className}`}>
  <!-- 专栏 (高亮显示) -->
  {!hideSeries && series && seriesId && (
    <a 
      href={`/column/${seriesId}`} 
      class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary hover:bg-primary/20 transition-colors font-medium text-xs"
    >
      {series}
    </a>
  )}

  <!-- 标签 (次级显示) -->
  {post.labels.map(label => (
    <a 
      href={`/category/${label.name}`}
      class="text-gray-500 hover:text-primary transition-colors hover:underline decoration-primary/30 underline-offset-4"
    >
      #{label.name}
    </a>
  ))}
</div>
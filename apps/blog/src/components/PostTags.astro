---
import { siteMeta, getSeriesIdByName, type Post } from '../utils/data';

interface Props {
  post: Post;
  hideSeries?: boolean;
  class?: string;
}

const { post, hideSeries = false, class: className = '' } = Astro.props;

const postMeta = siteMeta.posts_meta[post.id.toString()];
const series = postMeta?.series;
const seriesId = series ? getSeriesIdByName(series) : null;
---

<div
  class={`flex flex-wrap items-center gap-2 text-sm relative z-30 ${className}`}
>
  <!-- 专栏 (高亮显示) -->
  {
    !hideSeries && series && seriesId && (
      <a
        href={`/column/${seriesId}/`}
        class="px-2 py-0.5 rounded bg-primary-subtle text-primary-text border border-primary-border hover:bg-primary-hover transition-colors text-xs font-medium"
      >
        {series}
      </a>
    )
  }

  <!-- 标签 (次级显示) -->
  {
    post.labels.map((label) => (
      <a
        href={`/category/${label.name}/`}
        class="text-base-text-light hover:text-primary-text transition-colors hover:underline decoration-primary/20 underline-offset-4 py-1 text-xs relative z-30"
      >
        #{label.name}
      </a>
    ))
  }
</div>

---
/**
 * 紧凑行：[前导列] 标题 [尾随列]，用于归档、分类等需要快速扫视的列表
 */
interface Props {
  href: string;
  title: string;
  /** 前导列：月-日 */
  lead?: string | undefined;
  /** 尾随列：分类、篇数等次要信息 */
  trail?: string | undefined;
  /** 提供时尾随列可点击（如分类名） */
  trailHref?: string | undefined;
}

const { href, title, lead, trail, trailHref } = Astro.props;
---

<li class="flex items-baseline gap-3 sm:gap-6 py-2.5">
  {
    lead && (
      <span class="w-11 sm:w-12 shrink-0 text-sm text-base-text-light tabular-nums">
        {lead}
      </span>
    )
  }
  <!-- 移动端标题独占整行宽度，尾随列下沉为辅助信息；sm 以上恢复同行三列 -->
  <div
    class="flex-1 min-w-0 flex flex-col items-start gap-0.5 sm:flex-row sm:items-baseline sm:gap-6"
  >
    <a
      href={href}
      class="min-w-0 sm:flex-1 text-base leading-relaxed text-base-text hover:text-primary-text transition-colors"
    >
      {title}
    </a>
    {
      trail &&
        (trailHref ? (
          <a href={trailHref} class="shrink-0 text-sm link-muted">
            {trail}
          </a>
        ) : (
          <span class="shrink-0 text-sm text-base-text-light tabular-nums">
            {trail}
          </span>
        ))
    }
  </div>
</li>

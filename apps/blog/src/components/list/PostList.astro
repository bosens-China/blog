---
import ListRow from './ListRow.astro';
import RowList from './RowList.astro';
import SummaryRow from './SummaryRow.astro';
import YearGroup from './YearGroup.astro';
import { getPostCategory, getPostSeo, type Post } from '@/utils/data';
import { formatDate, formatMonthDay } from '@/utils/date';
import { groupByYear } from '@/utils/group';
import { routes } from '@/utils/routes';

interface Props {
  posts: Post[];
  /**
   * compact：按年份分组的单行列表，用于归档与分类
   * summary：标题 + 描述 + 元信息，用于首页
   */
  variant?: 'compact' | 'summary';
  /** 显示分类；分类详情页内无需重复 */
  showCategory?: boolean;
}

const { posts, variant = 'compact', showCategory = true } = Astro.props;

const categoryOf = (post: Post) =>
  showCategory ? getPostCategory(post) : undefined;
---

{
  variant === 'summary' ? (
    <RowList>
      {posts.map((post) => {
        const category = categoryOf(post);
        return (
          <SummaryRow
            href={routes.article(post.number)}
            title={post.title}
            description={getPostSeo(post)?.description}
            meta={[
              { text: formatDate(post.created_at) },
              {
                text: category ?? '',
                href: category ? routes.category(category) : undefined,
              },
            ]}
          />
        );
      })}
    </RowList>
  ) : (
    groupByYear(posts, (post) => post.created_at).map((group) => (
      <YearGroup year={group.year}>
        {group.items.map((post) => {
          const category = categoryOf(post);
          return (
            <ListRow
              href={routes.article(post.number)}
              title={post.title}
              lead={formatMonthDay(post.created_at)}
              trail={category}
              trailHref={category ? routes.category(category) : undefined}
            />
          );
        })}
      </YearGroup>
    ))
  )
}

---
import PostRow from './PostRow.astro';
import YearGroup from './YearGroup.astro';
import { getPostCategory, type Post } from '@/utils/data';
import { formatMonthDay } from '@/utils/date';
import { groupByYear } from '@/utils/group';
import { routes } from '@/utils/routes';

/** 按年份分组的文章列表，首页、归档与分类详情共用 */
interface Props {
  posts: Post[];
  /** 显示分类；分类详情页内无需重复 */
  showCategory?: boolean;
  /** 是否启用 50/50 左右双列分栏（分类详情等嵌入场景传 false） */
  split?: boolean | undefined;
}

const { posts, showCategory = true, split = true } = Astro.props;

const metaOf = (post: Post) => {
  const category = showCategory ? getPostCategory(post) : undefined;
  return [
    {
      text: category ?? '',
      href: category ? routes.category(category) : undefined,
    },
    { text: post.reading_time ? `${post.reading_time} 分钟` : '' },
  ];
};
---

{
  groupByYear(posts, (post) => post.created_at).map((group) => (
    <YearGroup year={group.year} split={split}>
      {group.items.map((post) => (
        <PostRow
          href={routes.article(post.number)}
          title={post.title}
          date={formatMonthDay(post.created_at)}
          meta={metaOf(post)}
        />
      ))}
    </YearGroup>
  ))
}

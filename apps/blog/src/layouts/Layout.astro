---
import '@/styles/global.css';
import { siteMeta } from '@/utils/data';
import { LITE_TRACK_TOKEN } from '@/consts';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import ThemeScript from '@/components/common/ThemeScript.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  keywords?: string[] | undefined;
  image?: string | undefined;
}

const {
  title,
  description = siteMeta.site_seo?.description || '一个小蜗的个人博客',
  keywords = siteMeta.site_seo?.keywords || [],
  image = '/favicon.svg',
} = Astro.props;

const siteTitle = title ? `${title} - 小蜗的个人博客` : '小蜗的个人博客';

// 只有在配置了 site 的情况下才生成绝对路径 URL，否则使用相对路径
const siteUrl = Astro.site ? Astro.site.origin : '';
const canonicalURL = siteUrl ? new URL(Astro.url.pathname, siteUrl) : null;
const socialImageURL = siteUrl ? new URL(image, siteUrl) : image;
const imgDomain = import.meta.env.PUBLIC_DOGECLOUD_DOMAIN;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {imgDomain && <link rel="preconnect" href={imgDomain} crossorigin />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- 基础 SEO 标签 (百度/搜狗友好) -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />

    <!-- 社交分享标签 (微信/知乎/微博友好) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content="小蜗的个人博客" />

    <ClientRouter />
    <script is:inline define:vars={{ token: LITE_TRACK_TOKEN }}>
      // 动态加载 LiteTrack SDK
      function loadLiteTrack() {
        return new Promise((resolve) => {
          if (window.LiteTrack) return resolve();
          // 防止重复注入
          if (document.querySelector('script[src="/liteTrack.js"]')) {
            // 如果脚本已存在但 LiteTrack 未就绪，轮询等待
            const check = setInterval(() => {
              if (window.LiteTrack) {
                clearInterval(check);
                resolve();
              }
            }, 100);
            return;
          }
          const script = document.createElement('script');
          script.src = '/liteTrack.js';
          script.onload = () => resolve();
          document.head.appendChild(script);
        });
      }

      // 更新页面上所有的阅读量计数器
      function updateViewCounts() {
        const counters = document.querySelectorAll('.view-counter');
        if (counters.length === 0) return;

        counters.forEach((container) => {
          const path = container.dataset.path;
          const countSpan = container.querySelector('.view-count-value');
          if (!path || !countSpan) return;

          if (window.LiteTrack) {
            window.LiteTrack.getPageStats(token, path)
              .then((stats) => {
                if (stats && stats.count !== undefined) {
                  countSpan.innerText = stats.count;
                }
              })
              .catch((e) => console.error(e));
          }
        });
      }

      // 初始化逻辑：加载 SDK -> 上报 -> 更新计数
      async function init() {
        await loadLiteTrack();
        if (window.LiteTrack) {
          window.LiteTrack.track(token, location.pathname);
          updateViewCounts();
        }
      }

      // 使用 astro:page-load 处理首次加载和后续导航
      // 这个事件在页面 hydration 完成后触发，是执行这类逻辑的最佳时机
      document.addEventListener('astro:page-load', init);
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <Header />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>

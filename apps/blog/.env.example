# --- 前端环境变量配置 ---
# 注意：在 Astro 中，只有以 PUBLIC_ 开头的变量才会在浏览器端生效

# 图床自定义加速域名 (必须包含 https:// 前缀)
# 用于前端图片组件识别并应用多吉云的数据处理参数 (imageView2)
PUBLIC_DOGECLOUD_DOMAIN=https://img.example.com

# 静态网站自定义域名 (必须包含 https:// 前缀)
# 用于 astro.config.mjs 中的 site 属性，影响 Sitemap、RSS 和 Canonical URL 的生成
DOGECLOUD_STATIC_DOMAIN=https://blog.example.com

# Ask AI 后端服务地址 (本地开发通常为 http://localhost:8000)
PUBLIC_ASK_AI_API=http://localhost:8000

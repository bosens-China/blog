APP_NAME="Blog AI Server"
# 生产环境必须为 false：DEBUG=true 会跳过所有 Origin/Referer 来源校验
DEBUG=false

# ===== 分层限流 =====
# 生产环境必须为 true
ENABLE_RATE_LIMIT=true
# 单 IP 每个窗口内的免费提问次数
RATE_LIMIT_FREE_TIER=5
# 配额窗口（秒），3600 = 每人每小时 5 次
RATE_LIMIT_WINDOW=3600
# 两次提问最小间隔（秒），0 关闭
RATE_LIMIT_BURST_INTERVAL=3
# 全站每日提问总上限（兜底 LLM 成本），按预算调整，0 关闭
GLOBAL_DAILY_CAP=2000

# ===== 输入约束 =====
# 单条消息最大字符数
MAX_MESSAGE_LENGTH=10000
# 注入给 LLM 的最近历史轮数（1 轮 = 用户 + 助手 2 条）
MAX_HISTORY_ROUNDS=10

# 允许访问的域名，生产环境务必填写具体的博客域名，多个域名用逗号分隔
# 示例: ["https://blog.example.com", "http://localhost:4321"]
ALLOWED_ORIGINS=["http://localhost:4321"]

REDIS_URL="redis://localhost:6379/0"

# OSS Data Source (AI 专用)
# 必须配置，指向 OSS 上存储 posts/{id}.json 的基础路径
# 请务必以斜杠结尾
BLOG_POSTS_BASE_URL="https://static.your-blog.com/_posts/"

LLM_API_KEY="sk-xxxx"
LLM_API_BASE="https://api.deepseek.com"
LLM_API_MODEL="deepseek-chat"
LLM_MAX_CONCURRENCY=200

APP_NAME="Blog AI Server"
DEBUG=false

# 登录用户限额
ENABLE_AI_RATE_LIMIT=true
AI_DAILY_LIMIT_PER_USER=10
COMMENT_HOURLY_LIMIT_PER_USER=10
COMMENT_MODERATION_INTERVAL_SECONDS=3600

# 输入与聊天历史
MAX_MESSAGE_LENGTH=10000
MAX_HISTORY_ROUNDS=10
MAX_COMMENT_LENGTH=2000

# 博客与请求来源
ALLOWED_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321"]
BLOG_FRONTEND_URL=http://localhost:4321
BLOG_POSTS_BASE_URL=https://static.example.com/_posts/
SESSION_COOKIE_SECURE=false

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
BLOG_AUTHOR_GITHUB_ID=

# PostgreSQL 与 Redis
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://blog:change-me@localhost:5543/blog
REDIS_URL=redis://localhost:6380/0

# 在线 LLM
LLM_API_KEY=sk-xxxx
LLM_API_BASE=https://api.deepseek.com
LLM_API_MODEL=deepseek-v4-flash
LLM_MAX_CONCURRENCY=200

# Chrome Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
